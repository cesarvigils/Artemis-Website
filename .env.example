# Artemis data bot configuration.
# Copy this file to .env and fill in the values. Never commit .env.
# Every setting the bot reads is listed here.

# --- Discord ---------------------------------------------------------------

# Bot token from the Bot page of your Discord application. Keep it secret.
DISCORD_TOKEN=

# Application Id from the General Information page of the same application.
DISCORD_CLIENT_ID=

# Id of the team server. Right click the server in Discord, Copy Server Id.
DISCORD_GUILD_ID=

# Optional channel id where every change is posted as a short embed. Leave empty to turn the log off.
LOG_CHANNEL_ID=

# Optional channel id where /result add posts a public results announcement. Leave empty to turn it off.
RESULTS_CHANNEL_ID=

# --- Storage ---------------------------------------------------------------

# Where the data files live: github for the real site, local for testing on disk.
STORAGE=github

# Folder holding results.json, drivers.json and events.json. In the website repo this is src/data.
DATA_DIR=src/data

# --- GitHub (needed when STORAGE=github) -----------------------------------

# Fine-grained personal access token for the website repository, Contents: Read and write. Keep it secret.
GITHUB_TOKEN=

# Account or organisation that owns the website repository.
GITHUB_OWNER=cesarvigils

# Repository name of the website.
GITHUB_REPO=Artemis-Website

# Branch Vercel deploys, so a change goes live: maintenance for production, redesign for previews.
GITHUB_BRANCH=maintenance

# GitHub API root. Only change this for GitHub Enterprise or when pointing the tests at a stub.
GITHUB_API_BASE=https://api.github.com

# --- Logging ---------------------------------------------------------------

# How much the bot writes to its log: debug, info, warn or error.
LOG_LEVEL=info
