{
  "name": "artemis-data-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot that edits the Artemis website data files (results, drivers, events) through slash commands.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/register-commands.js",
    "register:dry": "node src/register-commands.js --dry-run",
    "check": "node src/index.js --check",
    "test": "node --test"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  }
}
