---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PillarBand from '../components/PillarBand.astro';
import JoinCta from '../components/JoinCta.astro';
import site from '../data/site.json';

import huddle from '../assets/photos/crew-huddle.jpg';
import lan from '../assets/photos/lan-stage.jpg';
import portrait from '../assets/photos/member-portrait.jpg';
---

<Base
  pageType="AboutPage"
  title="About Artemis Esports"
  description="Artemis was founded in 2017 and has raced on iRacing since 2023. Publish the result, debrief in the open, the driver is the point."
>
  <PageHead title="About Artemis" lead={site.mission}>
    <dl class="founding" slot="aside">
      <div>
        <dt class="field-label">Founded</dt>
        <dd class="data">{site.founded}</dd>
      </div>
      <div>
        <dt class="field-label">First iRacing season</dt>
        <dd class="data">{site.simRacingSince}</dd>
      </div>
      <div>
        <dt class="field-label">Programs</dt>
        <dd class="data">Road and oval</dd>
      </div>
    </dl>
  </PageHead>

  <section class="section origin rule-top" aria-labelledby="origin-heading">
    <div class="container">
      <div class="origin-inner">
        <h2 class="display-md" id="origin-heading">Where this came from</h2>
        <div class="origin-copy">
          <p class="reveal">
            Artemis started in {site.founded} as a small competitive gaming crew. The sim
            racing program is newer: the first full iRacing season was {site.simRacingSince}.
            What carried over was the way the team works, not the game it was playing.
          </p>
          <p class="reveal" style="--reveal-delay: 60ms">
            Today the program runs two things at once. Endurance and GT on road courses,
            where a result comes from four hours of not making the mistake. And NASCAR
            ovals on Friday nights, where it comes from the last ten laps. Both
            programs share one roster and one debrief.
          </p>
        </div>
      </div>

      {/* The photographs are from the gaming side of the org, which is exactly
          the point of this section, so they sit inside the origin story with a
          caption saying what they are rather than under a heading about the
          racing team. */}
      <div class="collage">
        <figure class="shot shot-wide reveal">
          <div class="shot-frame">
          {/* Measured fractions, not guesses: the frame renders at 38% of a
              1440 viewport and stops growing at 545px once the shell caps,
              so the vw term is bracketed on both sides. */}
          {/* The ladder gained a 768 rung and the `vw` term tells the truth
              about the frame (the grid is inset by the page gutter, so it is
              not 100vw): together those turned an 84 KB fetch on a mobile
              profile into a 38 KB one for the same 648px frame. */}
          <Image
            src={huddle}
            alt="The Artemis Esports crew standing together outside an event in team jerseys"
            widths={[400, 640, 768, 960, 1280, 1920]}
            sizes="(min-width: 1512px) 545px, (min-width: 901px) 38vw, calc(100vw - 2.5rem)"
            format="webp"
            quality={72}
            loading="lazy"
            decoding="async"
          />
          </div>
          <figcaption>
            The crew outside an event, in team kit. Artemis was a gaming org before it
            was a race team.
          </figcaption>
        </figure>
        <figure class="shot shot-tall reveal" style="--reveal-delay: 60ms">
          <div class="shot-frame">
          <Image
            src={lan}
            alt="An Artemis player competing on stage at a LAN event"
            widths={[160, 320, 400, 480, 640, 853]}
            sizes="(min-width: 1512px) 320px, (min-width: 901px) 23vw, 46vw"
            format="webp"
            quality={72}
            loading="lazy"
            decoding="async"
          />
          </div>
          <figcaption>On stage at a LAN. This is the side of the org the sim program grew out of.</figcaption>
        </figure>
        <figure class="shot shot-small reveal" style="--reveal-delay: 120ms">
          <div class="shot-frame">
          <Image
            src={portrait}
            alt="An Artemis Esports member in the team jersey at an event"
            widths={[160, 320, 400, 480, 640, 960, 1280]}
            sizes="(min-width: 1512px) 376px, (min-width: 901px) 27vw, 46vw"
            format="webp"
            quality={72}
            loading="lazy"
            decoding="async"
          />
          </div>
          <figcaption>
            Off the clock. The roster is small enough that everyone knows everyone.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <PillarBand
    heading="What we stand for"
    lead="Three commitments, and the test anyone can run against each one."
    variant="long"
  />

  <JoinCta
    heading="How to join."
    lead="The open seats and what a season asks of you are on the join page. There is no form and no tryout weekend: open a ticket in the Discord and tell us what you race."
    steps={false}
  />
</Base>

<style>
  .founding {
    border-top: 1px solid var(--line-strong);
  }

  .founding > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
  }

  .founding dd {
    font-size: var(--text-xl);
    font-family: var(--font-data);
    font-weight: var(--weight-body);
    font-variant-numeric: tabular-nums;
    color: var(--mist);
    line-height: 1.1;
  }

  .origin-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .origin-inner h2 {
    max-width: 8em;
  }

  .origin-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .origin-copy p {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--mist-dim);
    max-width: var(--measure-lead);
  }

  .origin-copy p:first-child {
    color: var(--mist);
  }

  /* Collage: three frames of different proportion, stepped down the page
     rather than locked to a row. No empty cells, no equal grid. */
  .collage {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr) minmax(0, 1fr);
    gap: var(--space-m);
    align-items: start;
    margin-top: var(--space-2xl);
  }

  .shot-frame {
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-1);
  }

  /* :global is required: the <img> is rendered by Astro's Image
     component, so it does not carry this page's scope attribute.
     No hover zoom: these are captioned photographs, not links, and a frame
     that scales under the cursor promises a click that does not exist. */
  .shot-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot figcaption {
    margin-top: var(--space-xs);
    max-width: 42ch;
    color: var(--mist-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .shot-wide .shot-frame {
    aspect-ratio: 3 / 2;
  }

  .shot-tall {
    margin-top: var(--space-xl);
  }

  .shot-tall .shot-frame {
    aspect-ratio: 3 / 4;
  }

  .shot-small {
    margin-top: var(--space-2xl);
  }

  .shot-small .shot-frame {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 900px) {
    .origin-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .collage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      margin-top: var(--space-xl);
    }
    .shot-wide {
      grid-column: 1 / -1;
    }
    .shot-tall,
    .shot-small {
      margin-top: 0;
    }
    .shot-tall .shot-frame,
    .shot-small .shot-frame {
      aspect-ratio: 3 / 4;
    }
  }
</style>
