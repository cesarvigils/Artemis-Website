---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import huddle from '../assets/photos/DSC03992.jpg';
import lan from '../assets/photos/DSC03590.jpeg';
import portrait from '../assets/photos/IMG_1142.jpg';
---

<Base
  title="About | Artemis Esports"
  description="What Artemis Esports stands for: work over words, progress over pride, precision over flash, culture over clout."
>
  <section class="page-head">
    <div class="container">
      <p class="kicker reveal">Who we are</p>
      <h1 class="display-xl reveal" style="--reveal-delay: 60ms">
        Built in silence.
      </h1>
      <p class="lead about-mission reveal" style="--reveal-delay: 120ms">
        {site.mission}
      </p>
    </div>
  </section>

  <section class="section values">
    <div class="container">
      <ul class="values-list">
        {
          site.pillars.map((pillar, i) => (
            <li class="reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <h2 class="display-md">{pillar.title}</h2>
              <p>{pillar.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section people">
    <div class="container">
      <div class="people-copy reveal">
        <h2 class="display-lg">Our people, in person</h2>
        <p class="lead">
          The tags come off and the crew is still a crew. What we build is for
          them.
        </p>
      </div>
      <div class="photo-collage">
        <figure class="photo-wide reveal">
          <Image
            src={huddle}
            alt="The Artemis Esports crew gathered outside an event in team jerseys"
            widths={[700, 1200, 1800]}
            sizes="(max-width: 900px) 100vw, 66vw"
            format="webp"
            loading="lazy"
          />
        </figure>
        <figure class="photo-tall reveal" style="--reveal-delay: 80ms">
          <Image
            src={lan}
            alt="An Artemis player competing on stage at a LAN event"
            widths={[500, 900]}
            sizes="(max-width: 900px) 100vw, 32vw"
            format="webp"
            loading="lazy"
          />
        </figure>
        <figure class="photo-small reveal" style="--reveal-delay: 140ms">
          <Image
            src={portrait}
            alt="An Artemis Esports member in the team jersey"
            widths={[500, 900]}
            sizes="(max-width: 900px) 100vw, 40vw"
            format="webp"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section hashtag-band">
    <div class="container">
      <p class="hashtags">
        {site.hashtags.map((tag) => <span>{tag}</span>)}
      </p>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: calc(var(--nav-h) + clamp(4rem, 10vh, 7rem));
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }
  .page-head .kicker {
    margin-bottom: 1.25rem;
  }
  .about-mission {
    margin-top: 1.75rem;
    max-width: 46ch;
  }

  .values {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
  }
  .values-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .values-list li {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: baseline;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--line);
  }
  .values-list li:last-child {
    border-bottom: none;
  }
  .values-list p {
    color: var(--ink-dim);
  }

  .people {
    border-top: 1px solid var(--line);
  }
  .people-copy {
    max-width: 40rem;
    margin-bottom: 3rem;
  }
  .people-copy .lead {
    margin-top: 1.25rem;
  }
  .photo-collage {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 1.25rem;
  }
  .photo-collage figure {
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .photo-collage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .photo-collage figure:hover img {
      transform: scale(1.03);
    }
  }
  .photo-wide {
    grid-row: 1 / 3;
  }
  .photo-tall,
  .photo-small {
    aspect-ratio: 4 / 3;
  }

  .hashtag-band {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
    padding-block: 3.5rem;
  }
  .hashtags {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    max-width: none;
  }
  .hashtags span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 2.4vw, 1.75rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--teal-dim);
  }

  @media (max-width: 900px) {
    .values-list li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .photo-collage {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .photo-wide {
      grid-row: auto;
    }
  }
</style>
