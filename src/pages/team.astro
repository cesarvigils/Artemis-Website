---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import DriverCard from '../components/DriverCard.astro';
import JoinCta from '../components/JoinCta.astro';
import drivers from '../data/drivers.json';
import results from '../data/results.json';
import {
  activeDrivers,
  driverStats,
  driversInGroup,
  hasOwnPage,
  latestFinish,
  type Driver,
  type RaceResult,
} from '../lib/data';
import { stats } from '../lib/stats';

const GROUPS = [
  {
    key: 'road',
    title: 'Road',
    blurb: 'Endurance, GT and prototype. The drivers who run the long ones.',
  },
  {
    key: 'oval',
    title: 'Oval',
    blurb: 'Short tracks, superspeedways and the truck league.',
  },
  {
    key: 'crew',
    title: 'Pitwall',
    blurb: 'Strategy, engineering and the calendar behind every entry.',
  },
];

const roster = activeDrivers(drivers as Driver[]);
const races = results as RaceResult[];

const sections = GROUPS.map((group) => ({
  ...group,
  members: driversInGroup(roster, group.key),
})).filter((section) => section.members.length > 0);

const racingDrivers = roster.filter((driver) => driver.role === 'driver');
const crewCount = roster.length - racingDrivers.length;

/* The roster as an ItemList, which is what makes this a CollectionPage
   with something in it rather than a page merely typed as one. The list
   says what the page is a list OF and in what order it is presented.

   Same placeholder rule as everywhere else: an invented driver is not
   named here. Today that leaves an empty list, so the node is dropped
   entirely rather than shipping `numberOfItems: 0`, which would assert
   that Artemis has no drivers - a worse claim than saying nothing.

   Entries point at each driver's Person node by @id where the driver has
   a page, so the list resolves to the same entities those pages describe
   instead of duplicating them as strings. */
const listed = racingDrivers.filter((driver) => driver._placeholder !== true);

const rosterSchema = listed.length
  ? [
      {
        '@type': 'ItemList',
        '@id': new URL('/team#roster', Astro.site).href,
        name: 'Artemis Esports roster',
        numberOfItems: listed.length,
        itemListOrder: 'https://schema.org/ItemListUnordered',
        itemListElement: listed.map((driver, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: hasOwnPage(driver)
            ? { '@id': new URL(`/team/${driver.id}#person`, Astro.site).href }
            : { '@type': 'Person', name: driver.name, jobTitle: driver.focus },
        })),
      },
    ]
  : [];
---

<Base
  pageType="CollectionPage"
  schema={rosterSchema}
  title="The crew | Artemis Esports"
  description="The Artemis Esports roster: road drivers, oval drivers and the pitwall behind the endurance and GT program on iRacing."
>
  <PageHead
    title="The crew"
    lead="Everyone here earned the seat by showing up prepared, week after week."
    meta={`${racingDrivers.length} drivers / ${crewCount} crew / road and oval`}
  >
    {/* The right half of the first screen carries the entry list rather than
        400px of flat ground - and nothing at all when there are no entries,
        which collapses the split rather than reserving an empty column. */}
    {
      racingDrivers.length > 0 && (
        <ul class="entry-strip" slot="aside" aria-label="Car numbers">
          {racingDrivers.map((driver) => (
            <li>
              <a href={`#${driver.id}`}>
                <span class="entry-number" aria-hidden="true">
                  {driver.number}
                </span>
                <span class="entry-name">{driver.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </PageHead>

  {
    sections.length === 0 && (
      <section class="section rule-top" aria-labelledby="roster-empty">
        <div class="container">
          <h2 class="display-sm" id="roster-empty">
            Roster in transition
          </h2>
          <p class="lead roster-empty-lead">
            No drivers are published right now. The open seats and what a season
            asks of you are on the join page.
          </p>
        </div>
      </section>
    )
  }

  {
    sections.map((section) => (
      <section
        class:list={[
          'section roster rule-top',
          { 'is-stacked': section.members.length < 3 },
        ]}
        aria-labelledby={`group-${section.key}`}
      >
        <div class="container roster-inner">
          <div class="roster-head">
            <h2 class="display-sm" id={`group-${section.key}`}>
              {section.title}
            </h2>
            <p class="roster-blurb">{section.blurb}</p>
            <p class="roster-count data">
              {section.members.length} {section.members.length === 1 ? 'entry' : 'entries'}
            </p>
          </div>
          <ul class="roster-list">
            {section.members.map((driver, i) => (
              <DriverCard
                driver={driver}
                variant="row"
                href={hasOwnPage(driver) ? `/team/${driver.id}` : undefined}
                lastResult={latestFinish(races, driver.name)}
                stats={driverStats(stats, driver)}
                class="reveal"
                style={`--reveal-delay: ${i * 60}ms`}
              />
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <JoinCta
    heading="Race with us."
    lead="We are open to drivers in both programs. Bring consistency and a working microphone. The open seats and what a season asks of you are on the join page."
    steps={false}
  />
</Base>

<style>
  /* Entry list: the numbers, as a grid sheet reads them. */
  .entry-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .entry-strip li {
    border-bottom: 1px solid var(--line);
  }

  .entry-strip li:nth-child(3n + 2),
  .entry-strip li:nth-child(3n) {
    border-left: 1px solid var(--line);
  }

  .entry-strip a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-s) var(--space-s) var(--space-s) 0;
    transition: color var(--dur-2) var(--ease-out-quart);
  }

  .entry-strip li:nth-child(3n + 2) a,
  .entry-strip li:nth-child(3n) a {
    padding-left: var(--space-s);
  }

  .entry-number {
    font-family: var(--font-data);
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-display);
    font-size: var(--number-md);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--muted);
  }

  @supports not (-webkit-text-stroke: 1px currentColor) {
    .entry-number {
      color: var(--muted);
    }
  }

  .entry-name {
    font-family: var(--font-display);
    font-weight: var(--weight-small);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-2xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--mist-dim);
    overflow-wrap: anywhere;
  }

  .roster-empty-lead {
    margin-top: var(--space-s);
    max-width: var(--measure-lead);
  }

  .entry-name,
  .entry-number {
    transition: color var(--dur-2) var(--ease-out-quart),
      -webkit-text-stroke-color var(--dur-2) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .entry-strip a:hover .entry-name {
      color: var(--signal);
    }
    .entry-strip a:hover .entry-number {
      -webkit-text-stroke-color: var(--signal);
    }
  }

  .entry-strip a:focus-visible .entry-name {
    color: var(--signal);
  }

  .entry-strip a:focus-visible .entry-number {
    -webkit-text-stroke-color: var(--signal);
  }

  .entry-strip a:active {
    opacity: 0.65;
  }

  .roster-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .roster-head {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-m));
  }

  .roster-blurb {
    margin-top: var(--space-s);
    color: var(--mist-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    max-width: 30ch;
  }

  .roster-count {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--text-2xs);
    max-width: 12rem;
  }

  .roster-list {
    border-top: 1px solid var(--line-strong);
  }

  /* A sticky rail only earns its column when the list beside it is long
     enough to scroll past. Two entries leave 500px of empty gutter, so those
     groups run the head as a full-width bar with the count on the right. */
  .roster.is-stacked .roster-inner {
    display: block;
  }

  .roster.is-stacked .roster-head {
    position: static;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  .roster.is-stacked .roster-blurb {
    flex: 1 1 24ch;
    margin-top: 0;
    max-width: 46ch;
  }

  .roster.is-stacked .roster-count {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
    text-align: right;
  }

  @media (max-width: 1200px) {
    .roster-inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 2fr);
      gap: var(--space-l);
    }
  }

  @media (max-width: 900px) {
    .roster-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .roster-head {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .entry-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .entry-strip li:nth-child(3n + 2),
    .entry-strip li:nth-child(3n) {
      border-left: none;
    }
    .entry-strip li:nth-child(even) {
      border-left: 1px solid var(--line);
    }
    .entry-strip li:nth-child(3n + 2) a,
    .entry-strip li:nth-child(3n) a {
      padding-left: 0;
    }
    .entry-strip li:nth-child(even) a {
      padding-left: var(--space-s);
    }
  }
</style>
