---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import DriverCard from '../components/DriverCard.astro';
import JoinCta from '../components/JoinCta.astro';
import drivers from '../data/drivers.json';

const GROUPS = [
  {
    key: 'road',
    title: 'Road',
    blurb: 'Endurance, GT and prototype. The drivers who run the long ones.',
  },
  {
    key: 'oval',
    title: 'Oval',
    blurb: 'Short tracks, superspeedways and the truck league.',
  },
  {
    key: 'crew',
    title: 'Pitwall',
    blurb: 'Strategy, engineering and the calendar behind every entry.',
  },
];

const sections = GROUPS.map((group) => ({
  ...group,
  members: drivers.filter((driver) => driver.group === group.key),
})).filter((section) => section.members.length > 0);

const driverCount = drivers.filter((driver) => driver.group !== 'crew').length;
const crewCount = drivers.filter((driver) => driver.group === 'crew').length;
---

<Base
  title="Team | Artemis Esports"
  description="The Artemis Esports roster: road drivers, oval drivers and the pitwall behind the endurance and GT program on iRacing."
>
  <PageHead
    title="The crew"
    lead="Loyalty over attention. Everyone here earned the seat by showing up prepared, week after week."
    meta={`${driverCount} drivers / ${crewCount} crew / road and oval`}
  />

  {
    sections.map((section) => (
      <section class="section roster rule-top" aria-labelledby={`group-${section.key}`}>
        <div class="container roster-inner">
          <div class="roster-head">
            <h2 class="display-sm" id={`group-${section.key}`}>
              {section.title}
            </h2>
            <p class="roster-blurb">{section.blurb}</p>
            <p class="roster-count data">
              {section.members.length} {section.members.length === 1 ? 'entry' : 'entries'}
            </p>
          </div>
          <ul class="roster-list">
            {section.members.map((driver, i) => (
              <DriverCard
                driver={driver}
                variant="row"
                class="reveal"
                style={`--reveal-delay: ${i * 60}ms`}
              />
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <JoinCta
    heading="Race with us."
    lead="We are open to drivers in both programs. Bring consistency and a working microphone."
  />
</Base>

<style>
  .roster-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .roster-head {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-m));
  }

  .roster-blurb {
    margin-top: var(--space-s);
    color: var(--ink-dim);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 28ch;
  }

  .roster-count {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--text-2xs);
    max-width: 12rem;
  }

  .roster-list {
    border-top: 1px solid var(--line-strong);
  }

  @media (max-width: 900px) {
    .roster-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .roster-head {
      position: static;
    }
  }
</style>
