---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import cars from '../data/cars.json';
import partners from '../data/partners.json';

const racingImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/racing/*.{png,jpg,jpeg}'
);
const partnerImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/partners/*.{png,svg,webp}'
);

const heroSrc = (await racingImages[
  '../assets/racing/iRacingSim64DX11 2024-01-17 21-56-09.png'
]()).default;
const heroImg = await getImage({
  src: heroSrc,
  widths: [900, 1400, 1920],
  format: 'webp',
});

const garage = await Promise.all(
  cars.map(async (car) => {
    const mod = await racingImages[`../assets/racing/${car.image}`]();
    const meta = mod.default;
    const ratio = meta.width / meta.height;
    const shape = ratio < 1 ? 'portrait' : ratio > 2 ? 'wide' : 'standard';
    return { ...car, meta, shape };
  })
);

const partnerLogos = await Promise.all(
  partners.map(async (p) => {
    const mod = await partnerImages[`../assets/partners/${p.logo}`]();
    return { ...p, meta: mod.default };
  })
);

const headlineLines = ['Quiet.', 'Precise.', 'On the hunt.'];
const missionWords = site.mission.split(' ');
---

<Base
  title="Artemis Esports | Sim Racing Team"
  description="Artemis Esports is a sim racing team focused on endurance and GT racing on iRacing. Quiet. Precise. On the hunt."
>
  <!-- HERO ------------------------------------------------------- -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img
        src={heroImg.src}
        srcset={heroImg.srcSet.attribute}
        sizes="(max-width: 900px) 100vw, 62vw"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="kicker">Sim Racing Team</p>
        <h1 class="display-xl">
          {
            headlineLines.map((line) => (
              <span class="line">
                <span class="line-inner">{line}</span>
              </span>
            ))
          }
        </h1>
        <p class="lead">{site.heroSub}</p>
        <div class="hero-actions">
          <a href="/team" class="btn btn-solid" data-magnetic>Meet the team</a>
          <a href="/partners#contact" class="btn btn-ghost" data-magnetic>
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION ---------------------------------------------------- -->
  <section class="section mission">
    <div class="container">
      <p class="mission-statement">
        {
          missionWords.map((word) => (
            <span class:list={['m-word', { accent: word.startsWith('precision') }]}>
              {word}
            </span>
          ))
        }
      </p>
      <p class="mission-focus reveal">{site.focus}</p>
    </div>
  </section>

  <!-- PILLARS (sticky stack) -------------------------------------- -->
  <section class="pillars" aria-label="What we stand for">
    {
      site.pillars.map((pillar, i) => (
        <div class="pillar-panel" data-panel={i}>
          <div class="container pillar-inner">
            <h2 class="display-xl">{pillar.title}</h2>
            <p class="lead">{pillar.line}</p>
          </div>
        </div>
      ))
    }
  </section>

  <!-- GARAGE (horizontal pan) ------------------------------------- -->
  <section class="garage" id="garage">
    <div class="garage-track">
      <div class="garage-intro">
        <h2 class="display-lg">The garage</h2>
        <p class="lead">
          Endurance and GT machinery in Artemis colors. Every livery earns its
          leaves.
        </p>
      </div>
      {
        garage.map((car) => (
          <figure class:list={['garage-slide', `is-${car.shape}`]}>
            <div class="frame">
              <Image
                src={car.meta}
                alt={`${car.car} in the Artemis Esports livery`}
                widths={[700, 1100, 1600]}
                sizes="(max-width: 900px) 86vw, 62vw"
                format="webp"
                loading="lazy"
              />
            </div>
            <figcaption>
              <strong>{car.car}</strong>
              <span>{car.caption}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="garage-progress" aria-hidden="true"><span></span></div>
  </section>

  <!-- PARTNERS --------------------------------------------------- -->
  <section class="section partners-band">
    <div class="container partners-inner">
      <div class="partners-copy reveal">
        <h2 class="display-md">Partners of the hunt</h2>
        <p>
          We work with brands that value substance over noise.
          <a href="/partners" class="text-link">See our partners</a>
        </p>
      </div>
      <div class="partners-logos reveal" style="--reveal-delay: 100ms">
        {
          partnerLogos.map((p) => (
            <a href={p.url} target="_blank" rel="noopener" aria-label={p.name}>
              <Image
                src={p.meta}
                alt={p.name}
                height={64}
                densities={[1, 2]}
                format="webp"
              />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -------------------------------------------------------- -->
  <section class="cta-band">
    <div class="cta-marquee" aria-hidden="true">
      <div class="cta-marquee-track">
        {Array.from({ length: 6 }).map(() => <span>On the hunt</span>)}
        {Array.from({ length: 6 }).map(() => <span>On the hunt</span>)}
      </div>
    </div>
    <div class="container cta-inner">
      <h2 class="display-lg reveal">Race with us. Build with us.</h2>
      <div class="reveal" style="--reveal-delay: 100ms">
        <a href="/partners#contact" class="btn btn-solid" data-magnetic>
          Get in touch
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero ----------------------------------------------------------- */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: clip;
    padding-top: var(--nav-h);
  }
  .hero-media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 68%;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
  }
  .hero-media img {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: 62% center;
    will-change: transform;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        100deg,
        var(--bg) 10%,
        rgba(0, 10, 8, 0.82) 32%,
        rgba(0, 10, 8, 0.06) 60%
      ),
      linear-gradient(to top, var(--bg), transparent 32%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-copy {
    max-width: 34rem;
  }
  .hero-copy h1 .line {
    display: block;
    overflow: hidden;
  }
  .hero-copy h1 .line-inner {
    display: block;
  }
  .hero-copy .lead {
    margin-top: 1.5rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .hero .kicker {
    margin-bottom: 1.25rem;
  }

  /* Mission --------------------------------------------------------- */
  .mission {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
  }
  .mission-statement {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    line-height: 1.25;
    max-width: 26ch;
  }
  .m-word {
    display: inline-block;
    margin-right: 0.28em;
  }
  .m-word.accent {
    color: var(--teal);
  }
  .mission-focus {
    margin-top: 2.5rem;
    color: var(--ink-faint);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Pillars --------------------------------------------------------- */
  .pillar-panel {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .pillar-panel:nth-child(even) {
    background: var(--bg-raise);
  }
  .pillar-inner h2 {
    max-width: 12ch;
  }
  .pillar-inner .lead {
    margin-top: 1.5rem;
    color: var(--teal);
  }
  .pillar-panel:nth-child(even) .pillar-inner {
    margin-left: clamp(0rem, 14vw, 18rem);
  }

  /* Garage ----------------------------------------------------------- */
  .garage {
    position: relative;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .garage-track {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(4rem, 10vh, 7rem) var(--pad-x);
  }
  @media (min-width: 901px) {
    .garage-track {
      min-height: 100dvh;
    }
  }
  .garage-intro {
    flex: 0 0 auto;
    width: min(30rem, 80vw);
  }
  .garage-intro .lead {
    margin-top: 1.25rem;
  }
  .garage-slide {
    flex: 0 0 auto;
    width: min(58vw, 56rem);
  }
  .garage-slide.is-portrait {
    width: min(34vw, 30rem);
  }
  .garage-slide.is-wide {
    width: min(74vw, 72rem);
  }
  .garage-slide .frame {
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .garage-slide.is-portrait .frame {
    aspect-ratio: 4 / 5;
  }
  .garage-slide .frame img {
    width: 112%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    margin-left: -6%;
    will-change: transform;
  }
  .garage-slide figcaption {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    margin-top: 1rem;
  }
  .garage-slide strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .garage-slide span {
    color: var(--ink-dim);
    font-size: 0.9375rem;
  }
  .garage-progress {
    position: absolute;
    left: var(--pad-x);
    right: var(--pad-x);
    bottom: clamp(1.5rem, 4vh, 3rem);
    height: 2px;
    background: var(--line);
  }
  .garage-progress span {
    display: block;
    height: 100%;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (max-width: 900px) {
    .garage-progress {
      display: none;
    }
  }

  /* Partners --------------------------------------------------------- */
  .partners-band {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
  }
  .partners-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .partners-copy p {
    margin-top: 1.25rem;
    color: var(--ink-dim);
  }
  .text-link {
    color: var(--teal);
    border-bottom: 1px solid var(--line-teal);
    transition: border-color 200ms ease;
    margin-left: 0.35rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .text-link:hover {
      border-color: var(--teal);
    }
  }
  .partners-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    justify-content: flex-end;
    align-items: center;
  }
  .partners-logos img {
    height: 64px;
    width: auto;
    opacity: 0.85;
    transition: opacity 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .partners-logos a:hover img {
      opacity: 1;
    }
  }

  /* CTA --------------------------------------------------------------- */
  .cta-band {
    position: relative;
    padding-block: clamp(7rem, 18vh, 12rem);
    border-top: 1px solid var(--line);
    overflow: clip;
  }
  .cta-marquee {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .cta-marquee-track {
    display: flex;
    gap: 3rem;
    white-space: nowrap;
    animation: marquee 40s linear infinite;
  }
  .cta-marquee span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 16vw, 13rem);
    text-transform: uppercase;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(15, 255, 207, 0.14);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-marquee-track {
      animation: none;
    }
  }
  .cta-inner {
    position: relative;
  }
  .cta-inner .btn {
    margin-top: 2.5rem;
  }

  /* Mobile ------------------------------------------------------------ */
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
      padding-top: var(--nav-h);
    }
    .hero-media {
      position: relative;
      width: 100%;
      height: 46vh;
      clip-path: none;
    }
    .hero-media img {
      height: 100%;
    }
    .hero-media::after {
      background: linear-gradient(to top, var(--bg), transparent 45%);
    }
    .hero-inner {
      padding-block: 2.5rem 4rem;
    }
    .pillar-panel {
      min-height: 60vh;
    }
    .pillar-panel:nth-child(even) .pillar-inner {
      margin-left: 0;
    }
    .garage-track {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }
    .garage-slide,
    .garage-slide.is-wide {
      width: 86vw;
      scroll-snap-align: center;
    }
    .garage-slide.is-portrait {
      width: 70vw;
      scroll-snap-align: center;
    }
    .partners-inner {
      grid-template-columns: 1fr;
    }
    .partners-logos {
      justify-content: flex-start;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Motion-permitting, all viewports.
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Hero entrance: image settles, headline lines rise, copy follows.
    // Only when the tab is visible (rAF throttling would freeze it half-way);
    // the no-JS / hidden-tab default is a fully visible hero.
    if (!document.hidden) {
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      tl.from('.hero-media img', { scale: 1.08, opacity: 0, duration: 1.4 }, 0)
        .from('.hero .kicker', { y: 18, opacity: 0, duration: 0.7 }, 0.25)
        .from(
          '.hero h1 .line-inner',
          { yPercent: 115, duration: 1.0, stagger: 0.12 },
          0.35
        )
        .from('.hero-copy .lead', { y: 24, opacity: 0, duration: 0.8 }, 0.85)
        .from('.hero-actions', { y: 20, opacity: 0, duration: 0.7 }, 1.0);
      // Safety: never leave the hero half-revealed.
      setTimeout(() => tl.progress(1), 3500);
    }

    // Hero parallax + copy drift on scroll.
    gsap.to('.hero-media img', {
      yPercent: 10,
      ease: 'none',
      scrollTrigger: {
        trigger: '.hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });
    gsap.to('.hero-copy', {
      y: -48,
      opacity: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: '.hero',
        start: '30% top',
        end: '75% top',
        scrub: true,
      },
    });

    // Mission: words brighten line by line as the statement scrolls through.
    gsap.fromTo(
      '.m-word',
      { opacity: 0.16 },
      {
        opacity: 1,
        stagger: 0.6,
        ease: 'none',
        scrollTrigger: {
          trigger: '.mission-statement',
          start: 'top 78%',
          end: 'bottom 45%',
          scrub: true,
        },
      }
    );

    // Magnetic buttons: pull gently toward the cursor, spring back on leave.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
        const xTo = gsap.quickTo(btn, 'x', { duration: 0.4, ease: 'power3' });
        const yTo = gsap.quickTo(btn, 'y', { duration: 0.4, ease: 'power3' });
        btn.addEventListener('mousemove', (e) => {
          const r = btn.getBoundingClientRect();
          xTo((e.clientX - r.left - r.width / 2) * 0.3);
          yTo((e.clientY - r.top - r.height / 2) * 0.4);
        });
        btn.addEventListener('mouseleave', () => {
          xTo(0);
          yTo(0);
        });
      });
    }
  });

  // Pinned choreography: desktop + motion only. Mobile gets native scroll.
  mm.add(
    '(min-width: 901px) and (prefers-reduced-motion: no-preference)',
    () => {
      // Pillars: each panel pins at the top and hands off to the next.
      // Ascending z-index so each incoming panel covers the pinned one
      // before it (pinned panels are position: fixed and would otherwise
      // paint on top of the unpinned final panel).
      const panels = gsap.utils.toArray<HTMLElement>('.pillar-panel');
      panels.forEach((panel, i) => {
        panel.style.zIndex = String(i + 1);
      });
      panels.forEach((panel, i) => {
        if (i === panels.length - 1) return;
        ScrollTrigger.create({
          trigger: panel,
          start: 'top top',
          endTrigger: panels[panels.length - 1],
          end: 'top top',
          pin: true,
          pinSpacing: false,
        });
        gsap.to(panel.querySelector('.pillar-inner'), {
          opacity: 0.25,
          scale: 0.96,
          ease: 'none',
          scrollTrigger: {
            trigger: panels[i + 1],
            start: 'top bottom',
            end: 'top top',
            scrub: true,
          },
        });
      });

      // Garage: vertical scroll drives the horizontal track.
      const track = document.querySelector<HTMLElement>('.garage-track');
      const wrap = document.querySelector<HTMLElement>('.garage');
      if (track && wrap) {
        const distance = () => track.scrollWidth - window.innerWidth;
        const pan = gsap.to(track, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: wrap,
            start: 'top top',
            end: () => `+=${distance()}`,
            pin: true,
            scrub: 1,
            invalidateOnRefresh: true,
          },
        });

        // Each slide's image drifts inside its frame while panning.
        gsap.utils
          .toArray<HTMLElement>('.garage-slide .frame img')
          .forEach((img) => {
            gsap.fromTo(
              img,
              { xPercent: -5 },
              {
                xPercent: 5,
                ease: 'none',
                scrollTrigger: {
                  trigger: img.closest('.garage-slide') as HTMLElement,
                  containerAnimation: pan,
                  start: 'left right',
                  end: 'right left',
                  scrub: true,
                },
              }
            );
          });

        // Progress line: how far through the garage you are.
        gsap.to('.garage-progress span', {
          scaleX: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: wrap,
            start: 'top top',
            end: () => `+=${distance()}`,
            scrub: true,
          },
        });
      }
    }
  );
</script>
