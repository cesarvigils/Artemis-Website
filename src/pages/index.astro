---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import NextRace from '../components/NextRace.astro';
import ResultsTable from '../components/ResultsTable.astro';
import Garage from '../components/Garage.astro';
import DriverCard from '../components/DriverCard.astro';
import PillarBand from '../components/PillarBand.astro';
import PartnerBand from '../components/PartnerBand.astro';
import JoinCta from '../components/JoinCta.astro';
import Icon from '../components/Icon.astro';

import site from '../data/site.json';
import results from '../data/results.json';
import events from '../data/events.json';
import drivers from '../data/drivers.json';
import heroSource from '../assets/racing/daytona-porsche-911.jpg';

const heroImg = await getImage({
  src: heroSource,
  widths: [640, 1280, 1920],
  format: 'webp',
  quality: 64,
});

const recent = [...results]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);

const today = new Date().toISOString().slice(0, 10);
const nextEvent =
  [...events]
    .filter((event) => (event.endDate ?? event.date) >= today)
    .sort((a, b) => a.date.localeCompare(b.date))[0] ?? undefined;

const featured = drivers.filter((driver) => driver.group !== 'crew').slice(0, 4);
---

<Base
  title="Artemis Esports | iRacing endurance, GT and oval team"
  description="Artemis Esports is an iRacing endurance, GT and NASCAR oval team. Recent results, the next race, the cars and how to join the roster."
  preload={{
    href: heroImg.src,
    srcset: heroImg.srcSet.attribute,
    sizes: '(max-width: 900px) 100vw, 62vw',
  }}
>
  <Hero
    image={heroImg}
    alt="An Artemis Porsche 911 GT3 R on the grid at Daytona under floodlights"
    proof={recent[0]}
    ctaHref={site.socials.discord}
  />

  <NextRace event={nextEvent} />

  <section class="section rule-top" id="results" aria-labelledby="results-heading">
    <div class="container">
      <div class="section-head section-head-stack">
        <h2 class="display-md" id="results-heading">Recent results</h2>
        <p class="lead">The last six finishes, across endurance, GT and oval.</p>
      </div>
      <div class="reveal">
        <ResultsTable
          results={recent}
          caption="The six most recent Artemis Esports race results"
        />
      </div>
    </div>
  </section>

  <Garage />

  <section class="section rule-top" aria-labelledby="drivers-heading">
    <div class="container">
      <div class="section-head">
        <h2 class="display-md" id="drivers-heading">Who drives</h2>
        <a class="text-link" href="/team">
          Full roster
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ul class="roster-teaser reveal">
        {featured.map((driver) => <DriverCard driver={driver} variant="compact" />)}
      </ul>
    </div>
  </section>

  <PillarBand
    heading="How we race"
    lead="Four rules. They decide who we sign and how we run a stint."
  />

  <PartnerBand
    heading="Who backs us"
    lead="We keep the list short. A partner gets livery placement, result posts and a seat in the Discord."
    link={{ href: '/partners', label: 'What a partner gets' }}
  />

  <JoinCta />
</Base>
