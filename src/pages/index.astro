---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import NextRace from '../components/NextRace.astro';
import AudienceRouter from '../components/AudienceRouter.astro';
import ResultsTable from '../components/ResultsTable.astro';
import Garage from '../components/Garage.astro';
import DriverCard from '../components/DriverCard.astro';
import PillarBand from '../components/PillarBand.astro';
import PartnerBand from '../components/PartnerBand.astro';
import JoinCta from '../components/JoinCta.astro';
import Icon from '../components/Icon.astro';

import results from '../data/results.json';
import events from '../data/events.json';
import drivers from '../data/drivers.json';
import {
  driverStats,
  featuredDrivers,
  heroProof,
  lastCompletedEvent,
  recentResults,
  todayInTeamZone,
  upcomingEvents,
  type Driver,
  type RaceEvent,
  type RaceResult,
} from '../lib/data';
import { stats } from '../lib/stats';

/* The Artemis LMP2 at Interlagos: the only render in the set that carries no
   third-party decal, so the first screen makes no claim the Partners page has
   to contradict. */
import heroSource from '../assets/racing/interlagos-lmp2.jpg';

/* The ladder has steps at 828, 1024 and 1536 because the old 640/1280/1920 one
   made a 412px phone pull the 1280 file and a retina 1440 laptop pull the 1920.
   The 1024 step exists because the phone hero is painted at 130% of its layout
   box, so a 412px device asks for ~940px and would otherwise jump to 1280. */
const heroImg = await getImage({
  src: heroSource,
  widths: [640, 828, 1024, 1280, 1536, 1920],
  format: 'webp',
  quality: 58,
});

const recent = recentResults(results as RaceResult[], 6);
const proof = heroProof(results as RaceResult[]);
const today = todayInTeamZone();
const upcoming = upcomingEvents(events as RaceEvent[], today);
const lastDone = lastCompletedEvent(events as RaceEvent[]);
const featured = featuredDrivers(drivers as Driver[], 4);
const driverCount = (drivers as Driver[]).filter(
  (driver) => driver.active !== false && driver.role === 'driver'
).length;
---

<Base
  title="Artemis Esports | iRacing endurance, GT and oval team"
  description="Artemis is an iRacing endurance, GT and NASCAR oval team. Every shot on the record: recent results, the next race, the cars and how to join the roster."
  preload={{
    href: heroImg.src,
    srcset: heroImg.srcSet.attribute,
    /* Must match Hero.astro exactly. Below 900px the image is painted at
       130% of its layout box by the art-direction crop, so `100vw` had the
       browser selecting for 390px and displaying across 507px. */
    sizes: '(max-width: 900px) 130vw, 62vw',
  }}
>
  <Hero
    image={heroImg}
    alt="The Artemis Oreca 07 LMP2 running through the esses at Interlagos at dusk"
    proof={proof}
  />

  <NextRace upcoming={upcoming} lastDone={lastDone} />

  <AudienceRouter />

  <section class="section rule-top" id="scoreboard" aria-labelledby="scoreboard-heading">
    <div class="container">
      <div class="section-head section-head-stack">
        <h2 class="display-lg" id="scoreboard-heading">The Scoreboard</h2>
        <p class="lead">
          Recent results. The last six finishes across endurance, GT and oval,
          with the field size where we have it.
        </p>
      </div>
      {
        recent.length > 0 ? (
          <ResultsTable
            results={recent}
            caption="The six most recent Artemis race results"
          />
        ) : (
          <p class="lead">
            No finishes published yet. The next entry is on the calendar above.
          </p>
        )
      }
    </div>
  </section>

  <Garage />

  {/* No active drivers means no section: the heading, a "0 drivers" link and
      a 1px orphan hairline where the teaser was is worse than nothing. */}
  {
    featured.length > 0 && (
      <section class="section rule-top" aria-labelledby="drivers-heading">
        <div class="container">
          <div class="section-head">
            <h2 class="display-md" id="drivers-heading">
              Who drives
            </h2>
            <a class="text-link" href="/team">
              Full roster ({driverCount} {driverCount === 1 ? 'driver' : 'drivers'})
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <ul class="roster-teaser">
            {featured.map((driver) => (
              <DriverCard
                driver={driver}
                variant="compact"
                stats={driverStats(stats, driver)}
              />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <PillarBand
    heading="What we stand for"
    lead="Three commitments, each with a test anyone can run against us."
  />

  <PartnerBand
    heading="Who backs us"
    lead="A partner gets livery placement, result posts and a channel in the Discord."
    link={{ href: '/partners', label: 'What a partner gets' }}
  />

  <JoinCta />
</Base>
