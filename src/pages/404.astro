---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import nav from '../data/nav.json';

/* The Results entry is an anchor into the home page and is already the
   secondary action above, so the page list below stays the three real pages. */
const pages = nav.primary.filter((link) => !link.href.includes('#'));
---

<Base
  title="Page not found | Artemis Esports"
  description="That page does not exist. Head back to the Artemis Esports home page or join the team on Discord."
  monoBold
  noindex
>
  <section class="notfound">
    <div class="container notfound-inner">
      <span class="notfound-mark"><Mark variant="mark" /></span>

      {/* The same `[data-enter]` grammar the other four pages use. This was
          the one page on the site with no motion of any kind, which made it
          read as unfinished rather than as calm - and an error page is the
          one place where a little personality costs nothing, because nobody
          sees it twice. */}
      <div class="notfound-copy">
        <p class="notfound-code data" data-enter>404</p>
        <h1 class="display-lg" data-enter>Off track.</h1>
        {/* What happened, why it might have happened, and where to go: the
            three things an error page owes the reader. No apology, no joke. */}
        <p class="lead" data-enter style="--enter-delay: 60ms">
          That page does not exist, or it moved when the site was rebuilt. The
          main pages are below.
        </p>

        <div class="notfound-actions" data-enter style="--enter-delay: 120ms">
          <a class="btn btn-solid" href="/">
            Back to the paddock
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn-ghost" href="/#results">
            See results
            <Icon name="arrow-right" size={16} />
          </a>
        </div>

        <nav class="notfound-links" aria-label="Site pages" data-enter style="--enter-delay: 160ms">
          {pages.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    display: flex;
    align-items: center;
    min-height: calc(100dvh - var(--nav-h));
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }

  .notfound-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: var(--space-xl);
    align-items: center;
  }

  /* Committed rather than half-visible: at panel strength the mark read as a
     smudge over 40% of the composition. */
  .notfound-mark {
    display: block;
    --mark-size: min(18rem, 40vw);
    color: var(--line-teal);
  }

  /* Sized by width, not height. `Mark` sets `height: var(--mark-size);
     width: auto`, and the global `svg { max-width: 100% }` then clamped the
     width to the column while the height stayed at 288px, letterboxing a
     190px glyph in a 288px box with 50px of dead space above and below. */
  .notfound-mark :global(svg) {
    width: var(--mark-size);
    height: auto;
  }

  .notfound-code {
    color: var(--teal);
    letter-spacing: var(--track-label);
    margin-bottom: var(--space-s);
  }

  .notfound-copy .lead {
    margin-top: var(--space-s);
    max-width: var(--measure-lead);
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .notfound-links a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color var(--dur-2) var(--ease-out-quart),
      opacity var(--dur-1) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .notfound-links a:hover {
      color: var(--teal);
    }
  }

  .notfound-links a:focus-visible {
    color: var(--teal);
  }

  /* 860, not 760: at 768 the split survived into a 193px left column holding
     a 288px mark, and the equal-flex CTA rule was behind the same query, so
     the two buttons stacked at mismatched widths. */
  @media (max-width: 860px) {
    .notfound-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .notfound-mark {
      --mark-size: min(11rem, 42vw);
    }
    .notfound-actions .btn {
      flex: 1 1 13rem;
      max-width: 22rem;
    }
  }
</style>
