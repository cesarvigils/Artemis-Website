---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import partners from '../data/partners.json';

const partnerImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/partners/*.{png,svg,webp}'
);

const list = await Promise.all(
  partners.map(async (p) => {
    const mod = await partnerImages[`../assets/partners/${p.logo}`]();
    return { ...p, meta: mod.default };
  })
);
---

<Base
  title="Partners | Artemis Esports"
  description="The brands behind Artemis Esports, and how to work with our sim racing program."
>
  <section class="page-head">
    <div class="container">
      <h1 class="display-xl reveal">Partners</h1>
      <p class="lead reveal" style="--reveal-delay: 80ms">
        We keep the list short and the relationships real.
      </p>
    </div>
  </section>

  <section class="section partner-list">
    <div class="container">
      {
        list.map((p, i) => (
          <article class="partner-row reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <a
              class="partner-logo"
              href={p.url}
              target="_blank"
              rel="noopener"
              aria-label={p.name}
            >
              <Image
                src={p.meta}
                alt={p.name}
                height={96}
                densities={[1, 2]}
                format="webp"
              />
            </a>
            <div class="partner-info">
              <h2 class="display-md">{p.name}</h2>
              <p>{p.blurb}</p>
              <a class="text-link" href={p.url} target="_blank" rel="noopener">
                Visit {p.name}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="container contact-inner">
      <div class="contact-copy reveal">
        <h2 class="display-lg">Work with us</h2>
        <p class="lead">
          Livery placement, activations, and long-term partnerships around an
          endurance racing program that shows up prepared.
        </p>
      </div>
      <div class="contact-card reveal" style="--reveal-delay: 100ms">
        <p class="contact-label">Partnerships and general inquiries</p>
        <a class="contact-email" href={`mailto:${site.contactEmail}`}>
          {site.contactEmail}
        </a>
        <a href={`mailto:${site.contactEmail}`} class="btn btn-solid">
          Get in touch
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: calc(var(--nav-h) + clamp(4rem, 10vh, 7rem));
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }
  .page-head .lead {
    margin-top: 1.25rem;
  }

  .partner-list {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
  }
  .partner-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 3rem;
    align-items: center;
    padding-block: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .partner-row:first-child {
    padding-top: 0;
  }
  .partner-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .partner-logo img {
    height: clamp(64px, 8vw, 96px);
    width: auto;
  }
  .partner-info p {
    margin-block: 1rem 1.25rem;
    color: var(--ink-dim);
  }
  .text-link {
    color: var(--teal);
    border-bottom: 1px solid var(--line-teal);
    transition: border-color 200ms ease;
    font-size: 0.9375rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .text-link:hover {
      border-color: var(--teal);
    }
  }

  .contact {
    border-top: 1px solid var(--line);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  .contact-copy .lead {
    margin-top: 1.25rem;
  }
  .contact-card {
    border: 1px solid var(--line-teal);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .contact-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .contact-email {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--ink);
    word-break: break-all;
    transition: color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-email:hover {
      color: var(--teal);
    }
  }
  .contact-card .btn {
    margin-top: 0.75rem;
  }

  @media (max-width: 900px) {
    .partner-row,
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
