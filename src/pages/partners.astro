---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ResultsTable from '../components/ResultsTable.astro';
import PartnerBand from '../components/PartnerBand.astro';
import Icon from '../components/Icon.astro';

import site from '../data/site.json';
import results from '../data/results.json';
import drivers from '../data/drivers.json';
import {
  activeDrivers,
  podiumCount,
  recentResults,
  sortResults,
  type Driver,
  type RaceResult,
} from '../lib/data';
import { partnershipMailto } from '../lib/links';

/* The first item is the headline of the offer, so it takes the full width and
   the other three sit under it. Four equal cells made livery placement look
   like an afterthought next to "the Discord". */
const OFFER = [
  {
    title: 'Livery placement',
    line: 'Your mark on the endurance and GT cars, sized so it reads in a replay and on a stream overlay.',
  },
  {
    title: 'Result posts',
    line: 'Every finish gets a post across our channels, with the livery visible in the render.',
  },
  {
    title: 'Roster exposure',
    line: 'Driver profiles, race-week graphics and broadcast mentions carry the partner name.',
  },
  {
    title: 'The Discord',
    line: 'A channel inside the community the team actually lives in, not a logo on a static page.',
  },
];

const races = sortResults(results as RaceResult[]);
const snapshot = recentResults(races, 3);
const best = races.reduce((a, b) => (b.position < a.position ? b : a));
const podiums = podiumCount(races);
const tracks = [...new Set(races.map((race) => race.event))].slice(0, 4);
const classes = [...new Set(races.map((race) => race.class))];

const roster = activeDrivers(drivers as Driver[]).filter(
  (driver) => driver.role === 'driver'
);

const SOCIAL_LABELS: Record<string, string> = {
  discord: 'Discord',
  x: 'X',
  instagram: 'Instagram',
  tiktok: 'TikTok',
  youtube: 'YouTube',
  twitch: 'Twitch',
};

const channels = [
  ...Object.entries(site.socials)
    .filter(([, url]) => url)
    .map(([key, url]) => ({ label: SOCIAL_LABELS[key] ?? key, url })),
  { label: 'Store', url: site.store },
];
---

<Base
  title="Partners | Artemis Esports"
  description="What a partner gets from Artemis Esports: livery placement, result posts, roster exposure and the Discord community. Recent results, roster and contact."
>
  <PageHead
    title="Partner with Artemis"
    lead="Everything a sponsor needs to decide is on this page: what you get, what we have finished recently, who drives, and where the audience is."
    meta="2026 season / endurance, GT and oval"
  >
    {/* The action is in the first screen, not 3,600px down at the end. */}
    <a class="btn btn-solid" slot="action" href={partnershipMailto}>
      Partner with us
      <Icon name="arrow-right" size={16} />
    </a>

    <dl class="dossier" slot="aside">
      <div>
        <dt class="field-label">Best finish</dt>
        <dd class="data">
          P{best.position}{best.entries ? ` of ${best.entries}` : ''}, {best.event}
        </dd>
      </div>
      <div>
        <dt class="field-label">Results listed</dt>
        <dd class="data">{races.length}, {podiums} of them podiums</dd>
      </div>
      <div>
        <dt class="field-label">Classes run</dt>
        <dd class="data">{classes.join(' / ')}</dd>
      </div>
      <div>
        <dt class="field-label">Recent events</dt>
        <dd class="data">{tracks.join(' / ')}</dd>
      </div>
    </dl>
  </PageHead>

  <section class="section offer rule-top" aria-labelledby="offer-heading">
    <div class="container">
      <div class="section-head section-head-stack">
        <h2 class="display-md" id="offer-heading">What a partner gets</h2>
        <p class="lead">
          One package. We would rather do a small number of partnerships properly.
        </p>
      </div>
      <ul class="offer-grid">
        {
          OFFER.map((item, i) => (
            <li class="offer-item reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <h3 class="offer-title">{item.title}</h3>
              <p class="offer-line">{item.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="snapshot-heading">
    <div class="container">
      <div class="section-head">
        <h2 class="display-md" id="snapshot-heading">Recent results</h2>
        <a class="text-link" href="/#results">
          All results
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ResultsTable results={snapshot} caption="The three most recent Artemis Esports results" />

      {/* Roster exposure without re-running the home page's teaser: the
          numbers that would carry a partner mark, on one line. */}
      <div class="roster-line">
        <p class="field-label">Who runs these entries</p>
        <ul>
          {
            roster.map((driver) => (
              <li>
                <a href={`/team#${driver.id}`}>
                  <span class="roster-number data">{driver.number}</span>
                  {driver.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section reach rule-top" aria-labelledby="reach-heading">
    <div class="container reach-inner">
      <div class="reach-copy">
        <h2 class="display-md" id="reach-heading">Where the audience is</h2>
        <p class="lead">
          We do not publish follower counts on a marketing page. Ask and we will send
          current numbers from each dashboard, with the screenshots.
        </p>
      </div>
      <ul class="channel-list">
        {
          channels.map((channel) => (
            <li>
              <a href={channel.url} target="_blank" rel="noopener">
                <span>{channel.label}</span>
                <Icon name="arrow-up-right" size={15} />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <PartnerBand
    heading="Current partners"
    lead="The list is short because we only sign what we can service."
    variant="stack"
  />

  <section class="section contact rule-top" id="contact" aria-labelledby="contact-heading">
    <div class="container contact-inner">
      <div>
        <h2 class="display-lg" id="contact-heading">Talk to us.</h2>
        <p class="lead">
          Tell us what you want out of a season and we will tell you honestly whether we
          can deliver it. One email, one reply, no deck required.
        </p>
      </div>
      <div class="contact-card">
        <p class="field-label">Partnerships and general enquiries</p>
        <a class="contact-email" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        <a class="btn btn-solid contact-btn" href={partnershipMailto}>
          Partner with us
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .dossier {
    border-top: 1px solid var(--line-strong);
  }

  .dossier > div {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: var(--space-m);
    align-items: baseline;
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--line);
  }

  .dossier dd {
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* One headline item, then three. */
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m) var(--space-xl);
  }

  .offer-item {
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .offer-item:first-child {
    grid-column: 1 / -1;
    border-top-color: var(--line-strong);
  }

  .offer-title {
    font-size: var(--text-xl);
    letter-spacing: 0.02em;
  }

  .offer-item:first-child .offer-title {
    font-size: var(--text-2xl);
  }

  .offer-line {
    margin-top: var(--space-2xs);
    color: var(--ink-dim);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 40ch;
  }

  .offer-item:first-child .offer-line {
    font-size: var(--text-base);
    max-width: 52ch;
  }

  .roster-line {
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .roster-line ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-xs);
  }

  .roster-line a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .roster-number {
    color: var(--teal-soft);
    font-size: var(--text-2xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .roster-line a:hover {
      color: var(--teal);
    }
  }

  .reach-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .reach-copy h2 {
    max-width: 12ch;
  }

  .reach-copy .lead {
    margin-top: var(--space-s);
    max-width: 40ch;
  }

  /* Seven channels in a two-column grid left a visible hole in the last
     row. One column of seven reads as a list, which is what it is. */
  .channel-list {
    border-top: 1px solid var(--line);
  }

  .channel-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color var(--dur-hover) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .channel-list a:hover {
      color: var(--teal);
    }
  }

  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }

  .contact-inner h2 {
    max-width: 10ch;
  }

  .contact-inner .lead {
    margin-top: var(--space-s);
    max-width: 40ch;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
    padding: var(--space-l);
    border: 1px solid var(--line-teal);
    background: var(--bg-raise);
  }

  .contact-email {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: 0.02em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out);
  }

  .contact-btn {
    margin-top: var(--space-2xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-email:hover {
      color: var(--teal);
      border-color: var(--teal);
    }
  }

  @media (max-width: 900px) {
    .offer-grid {
      grid-template-columns: 1fr;
    }
    .dossier > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .reach-inner,
    .contact-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .contact-card {
      width: 100%;
      padding: var(--space-m);
    }
    .contact-btn {
      width: 100%;
    }
  }
</style>
