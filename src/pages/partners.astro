---
import { existsSync } from 'node:fs';

import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ResultsTable from '../components/ResultsTable.astro';
import PartnerBand from '../components/PartnerBand.astro';
import Icon from '../components/Icon.astro';

import site from '../data/site.json';
import results from '../data/results.json';
import drivers from '../data/drivers.json';
import {
  activeDrivers,
  podiumCount,
  recentResults,
  sortResults,
  type Driver,
  type RaceResult,
} from '../lib/data';
import { channelLinks, partnershipMailto } from '../lib/links';

/* Four peers, and the lead sentence under the heading calls them one package,
   so none of them is the headline. An earlier version promoted the first to
   full width above a row of three, which is a feature-card grid however it is
   labelled; these now read as a spec list. Order is the order a sponsor asks
   about them in, not a ranking. */
const OFFER = [
  {
    title: 'Livery placement',
    line: 'Your mark on the endurance and GT cars, sized so it reads in a replay and on a stream overlay.',
  },
  {
    title: 'Result posts',
    line: 'Every finish gets a post across our channels, with the livery visible in the render.',
  },
  {
    title: 'Roster exposure',
    line: 'Driver profiles, race-week graphics and broadcast mentions carry the partner name.',
  },
  {
    title: 'The Discord',
    line: 'A channel inside the community the team actually lives in, not a logo on a static page.',
  },
];

const races = sortResults(results as RaceResult[]);
const snapshot = recentResults(races, 3);
/* No initial value on this reduce used to throw a bare TypeError and kill the
   whole build the moment the bot wrote an empty results.json - which
   check:data accepts, because an empty file breaks no rule. Guarded the same
   way heroProof() in lib/data.ts already guards its own reduce. */
const best = races.length
  ? races.reduce((a, b) => (b.position < a.position ? b : a))
  : undefined;
const podiums = podiumCount(races);
const tracks = [...new Set(races.map((race) => race.event))].slice(0, 4);
const classes = [...new Set(races.map((race) => race.class))];

const roster = activeDrivers(drivers as Driver[]).filter(
  (driver) => driver.role === 'driver'
);

/* Shared with the footer: the store link carries the same guard in both
   places, so an empty site.store can never ship an href="" opening in a new
   tab. */
const channels = channelLinks(site.socials, site.store);

/* Build-time slot. The media kit is a file the owner drops into public/; when
   it is not there the link is not there either, which is better than a 404
   behind a sponsor-facing promise. */
const hasMediaKit = existsSync(new URL('../../public/media-kit.pdf', import.meta.url));
---

<Base
  pageType="ContactPage"
  title="Partner with Artemis Esports"
  description="What a partner gets from Artemis: livery placement, result posts, roster exposure and the Discord community. Recent results, roster and contact."
  cta="partnership"
>
  {/* A heading that speaks (an imperative or a statement) takes a full stop;
      a heading that names a page or a section does not. "Talk to us." below
      and "Race for us." on /join with one; "The crew", "About Artemis" and
      "Recent results" without. */}
  <PageHead
    title="Partner with Artemis."
    lead="Everything a sponsor needs to decide is on this page: what you get, what we have finished recently, who drives, and where the audience is."
    meta="2026 season / endurance, GT and oval"
  >
    {/* The action is in the first screen, not 3,600px down at the end. */}
    <a
      class="btn btn-solid"
      slot="action"
      href={partnershipMailto}
      data-umami-event="cta"
      data-umami-event-placement="hero"
      data-umami-event-audience="partner"
    >
      Partner with us
      <Icon name="arrow-right" size={16} />
    </a>

    {/* The whole dossier is evidence from results.json. With no results there
        is no dossier: a sponsor gets one honest line instead of four empty
        rows. */}
    {
      best ? (
        <dl class="dossier" slot="aside">
          <div>
            <dt class="field-label">Best finish</dt>
            <dd class="data">
              P{best.position}
              {best.entries ? ` of ${best.entries}` : ''}, {best.event}
            </dd>
          </div>
          <div>
            <dt class="field-label">Results listed</dt>
            <dd class="data">
              {races.length}, {podiums} of them podiums
            </dd>
          </div>
          <div>
            <dt class="field-label">Classes run</dt>
            <dd class="data">{classes.join(' / ')}</dd>
          </div>
          <div>
            <dt class="field-label">Recent events</dt>
            <dd class="data">{tracks.join(' / ')}</dd>
          </div>
        </dl>
      ) : (
        <p class="dossier-empty data" slot="aside">
          The season summary appears here once the first result is published.
        </p>
      )
    }
  </PageHead>

  <section class="section offer rule-top" aria-labelledby="offer-heading">
    <div class="container">
      <div class="section-head section-head-stack">
        <h2 class="display-md" id="offer-heading">What a partner gets</h2>
        <p class="lead">
          One package: the cars, the result posts, the roster graphics and the
          Discord.
        </p>
      </div>
      <ul class="offer-list">
        {
          OFFER.map((item, i) => (
            <li class="offer-item reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <h3 class="offer-title">{item.title}</h3>
              <p class="offer-line">{item.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-tight rule-top" aria-labelledby="snapshot-heading">
    <div class="container">
      <div class="section-head">
        {/* Named for what it is - three rows out of the season - with the
            link carrying the name of the thing it goes to. One label per
            destination: "The Scoreboard" is always /#scoreboard. */}
        <h2 class="display-md" id="snapshot-heading">Recent results</h2>
        <a class="text-link" href="/#scoreboard">
          The Scoreboard
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      {/* Never a column header row over nothing: the home page has always had
          this branch, the sponsor's page did not. */}
      {
        snapshot.length > 0 ? (
          <ResultsTable
            results={snapshot}
            caption="The three most recent Artemis Esports results"
          />
        ) : (
          <p class="lead">
            No finishes published for this season yet. The calendar and the full
            Scoreboard are on the home page.
          </p>
        )
      }

      {/* Roster exposure without re-running the home page's teaser: the
          numbers that would carry a partner mark, on one line. */}
      {
        roster.length > 0 && (
          <div class="roster-line">
            <p class="field-label">Who runs these entries</p>
            <ul>
              {roster.map((driver) => (
                <li>
                  <a href={`/team#${driver.id}`}>
                    <span class="roster-number data">{driver.number}</span>
                    <span class="roster-name">{driver.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section reach rule-top" aria-labelledby="reach-heading">
    <div class="container reach-inner">
      <div class="reach-copy">
        <h2 class="display-md" id="reach-heading">Where the audience is</h2>
        <p class="lead">
          Ask and we will send the current numbers from each dashboard, with the
          screenshots.
        </p>
        {/* Rendered only when public/media-kit.pdf is actually in the build.
            See CONTENT.md: dropping the file in is the whole publishing step. */}
        {
          hasMediaKit && (
            <a class="text-link media-kit" href="/media-kit.pdf">
              Media kit (PDF)
              <Icon name="arrow-right" size={16} />
            </a>
          )
        }
      </div>
      <ul class="channel-list">
        {
          channels.map((channel) => (
            <li>
              <a href={channel.url} target="_blank" rel="noopener">
                <span>{channel.label}</span>
                <Icon name="arrow-up-right" size={15} />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <PartnerBand
    heading="Current partners"
    lead="Who carries a mark on the cars, and since when."
    variant="stack"
  />

  <section class="section section-tall contact rule-top" id="contact" aria-labelledby="contact-heading">
    <div class="container contact-inner">
      <div>
        <h2 class="display-lg" id="contact-heading">Talk to us.</h2>
        <p class="lead">
          Tell us what you want out of a season and we will tell you honestly whether we
          can deliver it. One email, one reply, no deck required.
        </p>
      </div>
      <div class="contact-card">
        <p class="field-label">Partnerships and general enquiries</p>
        <a class="contact-email" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        <a
          class="btn btn-solid contact-btn"
          href={partnershipMailto}
          data-umami-event="cta"
          data-umami-event-placement="footer"
          data-umami-event-audience="partner"
        >
          Partner with us
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .dossier {
    border-top: 1px solid var(--line-strong);
  }

  /* `minmax(9rem, …)`: at 1024 the label track collapsed to 124px, which held
     three of the four labels and wrapped the fourth, so the row rhythm went
     58 / 70 / 58 / 100px. */
  .dossier > div {
    display: grid;
    grid-template-columns: minmax(9rem, 0.7fr) minmax(0, 1.6fr);
    gap: var(--space-m);
    align-items: baseline;
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--line);
  }

  .dossier dd {
    color: var(--mist);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .dossier-empty {
    padding-top: var(--space-s);
    border-top: 1px solid var(--line-strong);
    color: var(--muted);
    line-height: var(--leading-body);
    max-width: var(--measure-lead);
  }

  /* WHAT IS IN THE PACKAGE, AS A SPEC LIST
     This was one full-width item over a row of three, each a title with a
     line of prose under it: a feature-card grid by any other name, and the
     shape `DESIGN.md` section 1 lists as deliberately absent. It also made
     one of four peers arbitrarily the headline, when the copy directly
     above calls them "one package".

     A run-in list instead - the label on the same line as the thing it
     labels, the way a spec sheet sets it. Not the label/value split the
     dossier already uses further up this page, and not a grid at all, so
     the page loses a composition rather than trading one for another. */
  .offer-list {
    max-width: var(--measure);
    border-top: 1px solid var(--line-strong);
  }

  .offer-item {
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
  }

  /* Run-in: the title sets the line, the sentence continues it. Uppercase
     Archivo here is the site's register for labelling a value, which is
     exactly this title's job. */
  .offer-title {
    display: inline;
    font-family: var(--font-display);
    font-weight: var(--weight-small);
    font-size: var(--text-sm);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--mist);
  }

  .offer-title::after {
    content: '.';
    color: var(--muted);
  }

  .offer-line {
    display: inline;
    margin-left: 0.5ch;
    color: var(--mist-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .roster-line {
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .roster-line ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
    margin-top: 0;
  }

  /* Six 22px links at an 8px row gap was a 30px pitch and the smallest set of
     targets on the site. The height goes on the link, not on the list gap. */
  .roster-line a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: var(--weight-small);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-xs);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--mist-dim);
    transition: color var(--dur-2) var(--ease-out-quart);
  }

  .roster-name {
    overflow-wrap: anywhere;
  }

  .roster-number {
    color: var(--muted);
    font-size: var(--text-2xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .roster-line a:hover {
      color: var(--signal);
    }
  }

  .roster-line a:focus-visible {
    color: var(--signal);
  }

  .roster-line a:active {
    opacity: 0.65;
  }

  /* Ratio'd, not halved. This was `1fr 1fr` - 573px each at 1440 - which put
     a heading with a paragraph under it in the same measure as a list of
     one-line channel rows, two things that are not the same size of idea.
     Every other split on this page is already ratio'd for that reason
     (`.dossier` 0.7/1.6, `.contact-inner` 1.15/1), and a lone 50/50 between
     them read as the one band nobody had decided about. */
  .reach-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .reach-copy h2 {
    max-width: 9em;
  }

  .reach-copy .lead {
    margin-top: var(--space-s);
    max-width: var(--measure-lead);
  }

  .media-kit {
    margin-top: var(--space-s);
  }

  /* Seven channels in a two-column grid left a visible hole in the last
     row. One column of seven reads as a list, which is what it is.

     `--line-strong` above the first row, `--line` between rows: the site's
     rule is that a hairline opening a data block is the strong step and a
     hairline separating two things inside one block is the light step. Every
     other list head on the site (the results head, the roster, the entry
     strip, the dossier, the join steps, the pillar register) already did
     this; this one did not. */
  .channel-list {
    border-top: 1px solid var(--line-strong);
  }

  .channel-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 44px;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-sm);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--mist-dim);
    transition: color var(--dur-2) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .channel-list a:hover {
      color: var(--signal);
    }
  }

  .channel-list a:focus-visible {
    color: var(--signal);
  }

  .channel-list a:active {
    opacity: 0.65;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }

  .contact-inner h2 {
    max-width: 8em;
  }

  .contact-inner .lead {
    margin-top: var(--space-s);
    max-width: var(--measure-lead);
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
    padding: var(--space-l);
    border: 1px solid var(--line-strong);
    background: var(--surface-1);
  }

  .contact-email {
    display: inline-block;
    min-height: 44px;
    padding-block: 0.55rem;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-xl);
    letter-spacing: var(--track-title);
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-2) var(--ease-out-quart),
      border-color var(--dur-2) var(--ease-out-quart);
  }

  .contact-btn {
    margin-top: var(--space-2xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-email:hover {
      color: var(--signal);
      border-color: var(--signal);
    }
  }

  .contact-email:focus-visible {
    color: var(--signal);
    border-color: var(--signal);
  }

  .contact-email:active {
    opacity: 0.65;
  }

  @media (max-width: 900px) {
    .dossier > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .reach-inner,
    .contact-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .contact-card {
      width: 100%;
      padding: var(--space-m);
    }
  }

  /* Full-width is right on a phone and wrong on a 706px tablet, where it made
     a 13-character label sit alone in the middle of a teal slab. */
  @media (max-width: 560px) {
    .contact-btn {
      width: 100%;
    }
  }
</style>
