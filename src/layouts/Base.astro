---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import site from '../data/site.json';
import { analyticsEnabled, umamiSrc, umamiWebsiteId } from '../lib/analytics';

interface Props {
  title: string;
  description: string;
  /** Optional path to an OG image inside /public, defaults to the brand banner */
  ogImage?: string;
  /** LCP image to preload: pass the getImage() result fields for the hero */
  preload?: { href: string; srcset?: string; sizes?: string };
  /**
   * The page's primary action, for the sticky phone bar. Same keys as
   * CTA_INTENTS. `none` on the 404, which has no primary action worth
   * pinning to the bottom of a page that is already short.
   */
  cta?: 'join' | 'apply' | 'partnership' | 'none';
  /**
   * A document that is not a page. `dist/404.html` is both Vercel's
   * not-found document and a real file at `/404`, which a host serves with a
   * 200, so without this it is an indexable soft-404 that is not in the
   * sitemap. A not-found document also has no canonical URL and should not
   * assert an organisation.
   */
  noindex?: boolean;
  /**
   * `og:type`. `website` for a site's pages; `profile` for a page that is
   * about one person, which is what a driver page is.
   */
  ogType?: 'website' | 'profile';
  /**
   * Extra JSON-LD nodes for this page, joined with the organisation node in
   * one `@graph`. A page passes what only it can know - its breadcrumb
   * trail, the person it describes - rather than this layout guessing from
   * the pathname. Suppressed entirely when `noindex` is set, along with the
   * organisation node, because a document a crawler is told to skip should
   * not be asserting facts on the way past.
   */
  schema?: Record<string, unknown>[];
  /**
   * The schema.org type of this document. Every page gets a node for
   * itself, not just for the team that publishes it: `WebPage` is the
   * honest default, and the subtypes below say what KIND of page it is,
   * which is the difference between "a page exists here" and "this is the
   * page about the organisation".
   *
   * `ProfilePage` is the one with a documented Google use - it marks a
   * page as being about one person or account - so driver pages take it.
   * `CollectionPage` is for a page whose point is a list (the roster, the
   * standings table). `AboutPage` and `ContactPage` are self-describing.
   */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ProfilePage';
}

const {
  title,
  description,
  ogImage = '/og.png',
  preload,
  cta = 'join',
  noindex = false,
  ogType = 'website',
  schema = [],
  pageType = 'WebPage',
} = Astro.props;

/* One slash policy, everywhere. Astro emits `/team/` as the page's own
   pathname while every internal link, the sitemap and vercel.json use the
   bare form; served as-is that left two live URLs for one page with only the
   canonical tag to de-duplicate them. */
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);

/* One structured-data block, built from the same data the page renders, so a
   search result can show the team and its real channels rather than guessing.
   The `@id` matters: without it the copies are anonymous nodes instead of one
   entity described several times. Deliberately not here: the roster (the
   names are flagged as placeholders and must not be published as structured
   claims), the calendar, and any rating. */
const structuredData = {
  '@type': 'SportsTeam',
  '@id': new URL('/#organization', Astro.site).href,
  name: site.name,
  alternateName: site.team,
  url: Astro.site?.href,
  description: site.shortDescription,
  sport: ['Sim racing', 'Esports'],
  foundingDate: String(site.founded),
  email: site.contactEmail,
  /* The same address as a typed node. `email` alone is a bare string; a
     ContactPoint says what the address is FOR, which is what lets a result
     surface it as "contact" rather than as an unlabelled property. */
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'general enquiries',
    email: site.contactEmail,
    availableLanguage: 'English',
  },
  slogan: site.tagline,
  image: new URL(ogImage, Astro.site).href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.png', Astro.site).href,
    width: 192,
    height: 192,
  },
  sameAs: [...Object.values(site.socials).filter(Boolean), site.store],
};

/* The site as an entity, pointing at the team that publishes it. Two nodes
   rather than one because they are different things - an organisation and
   the site it runs - and a search engine resolving "Artemis Esports" wants
   the organisation, while a sitelink or a site-name result wants this.

   Deliberately NO `potentialAction` / SearchAction. That is what makes a
   site eligible for the sitelinks search box, and it takes a URL template
   pointing at a real search endpoint. This site has no search, so declaring
   one would be a claim that resolves to a 404 - structured data has to
   match what the page actually offers. Add it if a search route is ever
   built, not before. */
const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: Astro.site?.href,
  name: site.name,
  inLanguage: 'en-GB',
  publisher: { '@id': new URL('/#organization', Astro.site).href },
};

/* The document itself. Without this the graph described a team and a site
   but never the page a crawler was actually holding, which left every
   page-level fact - its title, its description, its image, its position in
   the site - asserted only in meta tags that carry no relationships.

   `isPartOf` binds it to the WebSite node, `about` to the organisation,
   and `primaryImageOfPage` names which of the page's images represents it.
   A page that passed a BreadcrumbList gets `breadcrumb` pointing at that
   node by @id rather than repeating the trail, which is the whole reason
   these live in one @graph. */
const breadcrumbNode = schema.find((node) => node['@type'] === 'BreadcrumbList');

const webPage = {
  '@type': pageType,
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: 'en-GB',
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  about: { '@id': new URL('/#organization', Astro.site).href },
  primaryImageOfPage: { '@id': `${new URL(ogImage, Astro.site).href}#primaryimage` },
  ...(breadcrumbNode ? { breadcrumb: { '@id': `${canonical.href}#breadcrumb` } } : {}),
};

/* The image as a node rather than a bare URL, so `primaryImageOfPage` above
   resolves to something with dimensions instead of dangling. Same file the
   OG tags point at. */
const primaryImage = {
  '@type': 'ImageObject',
  '@id': `${new URL(ogImage, Astro.site).href}#primaryimage`,
  url: new URL(ogImage, Astro.site).href,
  contentUrl: new URL(ogImage, Astro.site).href,
  width: 1200,
  height: 630,
};

/* One script tag, not several. Multiple ld+json blocks are legal and
   parsers accept them, but nodes in separate blocks cannot reference each
   other by `@id`, so a breadcrumb or a person emitted alongside would be a
   second anonymous island rather than something attached to this team. A
   single `@graph` lets a page's own nodes point back at `/#organization`
   and be read as one description of one entity. */
/* A BreadcrumbList needs an @id for `webPage.breadcrumb` to point at. The
   page passes the trail; the @id is this layout's job, because only it
   knows the canonical URL the node hangs off. */
const graph = [
  structuredData,
  website,
  webPage,
  primaryImage,
  ...schema.map((node) =>
    node['@type'] === 'BreadcrumbList' ? { '@id': `${canonical.href}#breadcrumb`, ...node } : node
  ),
];
---

<!doctype html>
{/* en-GB, not en: the copy is British throughout (licence, colour,
    behaviour) and `og:locale` below already says so. They have to agree -
    a screen reader picks its pronunciation rules from this attribute. */}
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    {/* `viewport-fit=cover` or every `env(safe-area-inset-*)` on the site
        resolves to 0 and the notch handling is decorative. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0e0d" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* Preview limits, on indexable pages only - a noindex page has nothing
        to preview and the two directives would contradict each other.

        Google clamps text snippets and image previews conservatively unless
        told otherwise, and the defaults cost this site specifically:
        `max-image-preview:large` is what allows a full-width image in a
        result and is a stated requirement for Google Discover eligibility,
        which for a team whose content is liveries and race photography is
        the difference between a thumbnail and the actual car. `max-snippet`
        and `max-video-preview` at -1 lift the length caps rather than set
        one, so Google picks the most useful snippet instead of a truncated
        default.

        This is a permission, not a demand: Google still chooses what to
        show. There is nothing here to hold back - every image is the
        team's own and every page is meant to be read in full. */}
    {!noindex && (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Generated from site.json - see src/pages/site.webmanifest.ts. No
        `crossorigin`: the manifest is same-origin and fetching it with
        credentials would only narrow what can serve it. */}
    <link rel="manifest" href="/site.webmanifest" />
    {/* The results feed. `rel="alternate"` is the standard pointer from a
        document to the machine-readable stream of the same content, and it
        is how feed readers and aggregators discover one without being
        told. See src/pages/feed.xml.ts. */}
    <link rel="alternate" type="application/rss+xml" title="Artemis Esports results" href="/feed.xml" />

    {/* The two core faces, preloaded on every route because both are above
        the fold on every route: Archivo sets the h1 and Inter sets the lead,
        the field labels and every number. Preloading only Inter was measured
        and rejected - it moved FCP from 0.8s to 1.2s and introduced a 0.002
        CLS on three routes, because the h1 then painted in the fallback and
        swapped.

        The two `ext` faces are deliberately NOT preloaded. They cover the
        characters only a name can need, the browser fetches one the moment it
        has to render such a character, and preloading them would spend 51 KB
        on every first paint for glyphs no page currently uses.

        These filenames also appear in the @font-face block at the top of
        global.css; `/fonts/*` is cached immutable for a year, so a new face
        means a new filename. Keep the two lists in step. */}
    <link rel="preload" href="/fonts/archivo-core.latin.v3.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-core.latin.v3.woff2" as="font" type="font/woff2" crossorigin />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.href}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:site_name" content="Artemis Esports" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_GB" />
    {/* Declared dimensions: Slack, Discord and LinkedIn render the card
        faster when they do not have to fetch the file to size it, and some
        of them skip a card they cannot size cheaply. */}
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`Artemis Esports - ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@EsportsArtemis" />

    {
      !noindex && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
        />
      )
    }

    {/* The analytics script is on a third origin, so its DNS lookup, TCP
        handshake and TLS negotiation all happen before the browser has any
        reason to know about it. `preconnect` starts them during head parse
        instead. Only emitted when the tag is - a preconnect to a host this
        build never contacts is a wasted connection, and on a site that
        ships no third-party script by default it would be the only one. */}
    {analyticsEnabled && <link rel="preconnect" href={new URL(umamiSrc).origin} crossorigin />}

    {/* Cookieless analytics, and only when this build was given a website id.
        With the variable unset nothing is requested, nothing is stored, and
        the footer says so. See lib/analytics.ts and DEPLOY.md. */}
    {
      analyticsEnabled && (
        <script defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <span data-nav-sentinel aria-hidden="true"></span>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {cta !== 'none' && <StickyCta intent={cta} />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  /* The sentinel marks "page is at the top"; it must not affect layout.
     64px tall, not 1px: at 1px the header flipped to solid at roughly two
     pixels of scroll and back again, which is a hair trigger on a 200ms
     cross-fade. */
  [data-nav-sentinel] {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 64px;
    pointer-events: none;
  }

  #main:focus {
    outline: none;
  }

  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }
</style>
