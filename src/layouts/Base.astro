---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  /** Optional path to an OG image inside /public, defaults to the brand banner */
  ogImage?: string;
  /** LCP image to preload: pass the getImage() result fields for the hero */
  preload?: { href: string; srcset?: string; sizes?: string };
}

const { title, description, ogImage = '/og.png', preload } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/* One structured-data block, built from the same data the page renders, so a
   search result can show the team and its real channels rather than guessing. */
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: site.name,
  sport: 'Sim racing',
  url: Astro.site?.href,
  logo: new URL('/favicon.png', Astro.site).href,
  foundingDate: String(site.founded),
  email: site.contactEmail,
  description: site.shortDescription,
  sameAs: [...Object.values(site.socials).filter(Boolean), site.store],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* `viewport-fit=cover` or every `env(safe-area-inset-*)` on the site
        resolves to 0 and the notch handling is decorative. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000a08" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/nexa-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nexa-light.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Mono 400 sets the hero proof row above the fold; 700 is used first below it. -->
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.href}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:site_name" content="Artemis Esports" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@EsportsArtemis" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <span data-nav-sentinel aria-hidden="true"></span>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  /* The sentinel marks "page is at the top"; it must not affect layout. */
  [data-nav-sentinel] {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  #main:focus {
    outline: none;
  }

  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }
</style>
