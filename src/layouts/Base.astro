---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import site from '../data/site.json';
import { analyticsEnabled, umamiSrc, umamiWebsiteId } from '../lib/analytics';

interface Props {
  title: string;
  description: string;
  /** Optional path to an OG image inside /public, defaults to the brand banner */
  ogImage?: string;
  /** LCP image to preload: pass the getImage() result fields for the hero */
  preload?: { href: string; srcset?: string; sizes?: string };
  /**
   * The page's primary action, for the sticky phone bar. Same keys as
   * CTA_INTENTS. `none` on the 404, which has no primary action worth
   * pinning to the bottom of a page that is already short.
   */
  cta?: 'join' | 'apply' | 'partnership' | 'none';
  /**
   * A document that is not a page. `dist/404.html` is both Vercel's
   * not-found document and a real file at `/404`, which a host serves with a
   * 200, so without this it is an indexable soft-404 that is not in the
   * sitemap. A not-found document also has no canonical URL and should not
   * assert an organisation.
   */
  noindex?: boolean;
  /**
   * `og:type`. `website` for a site's pages; `profile` for a page that is
   * about one person, which is what a driver page is.
   */
  ogType?: 'website' | 'profile';
  /**
   * Extra JSON-LD nodes for this page, joined with the organisation node in
   * one `@graph`. A page passes what only it can know - its breadcrumb
   * trail, the person it describes - rather than this layout guessing from
   * the pathname. Suppressed entirely when `noindex` is set, along with the
   * organisation node, because a document a crawler is told to skip should
   * not be asserting facts on the way past.
   */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og.png',
  preload,
  cta = 'join',
  noindex = false,
  ogType = 'website',
  schema = [],
} = Astro.props;

/* One slash policy, everywhere. Astro emits `/team/` as the page's own
   pathname while every internal link, the sitemap and vercel.json use the
   bare form; served as-is that left two live URLs for one page with only the
   canonical tag to de-duplicate them. */
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);

/* One structured-data block, built from the same data the page renders, so a
   search result can show the team and its real channels rather than guessing.
   The `@id` matters: without it the copies are anonymous nodes instead of one
   entity described several times. Deliberately not here: the roster (the
   names are flagged as placeholders and must not be published as structured
   claims), the calendar, and any rating. */
const structuredData = {
  '@type': 'SportsTeam',
  '@id': new URL('/#organization', Astro.site).href,
  name: site.name,
  alternateName: site.team,
  url: Astro.site?.href,
  description: site.shortDescription,
  sport: ['Sim racing', 'Esports'],
  foundingDate: String(site.founded),
  email: site.contactEmail,
  slogan: site.tagline,
  image: new URL(ogImage, Astro.site).href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.png', Astro.site).href,
    width: 192,
    height: 192,
  },
  sameAs: [...Object.values(site.socials).filter(Boolean), site.store],
};

/* The site as an entity, pointing at the team that publishes it. Two nodes
   rather than one because they are different things - an organisation and
   the site it runs - and a search engine resolving "Artemis Esports" wants
   the organisation, while a sitelink or a site-name result wants this.

   Deliberately NO `potentialAction` / SearchAction. That is what makes a
   site eligible for the sitelinks search box, and it takes a URL template
   pointing at a real search endpoint. This site has no search, so declaring
   one would be a claim that resolves to a 404 - structured data has to
   match what the page actually offers. Add it if a search route is ever
   built, not before. */
const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: Astro.site?.href,
  name: site.name,
  inLanguage: 'en-GB',
  publisher: { '@id': new URL('/#organization', Astro.site).href },
};

/* One script tag, not several. Multiple ld+json blocks are legal and
   parsers accept them, but nodes in separate blocks cannot reference each
   other by `@id`, so a breadcrumb or a person emitted alongside would be a
   second anonymous island rather than something attached to this team. A
   single `@graph` lets a page's own nodes point back at `/#organization`
   and be read as one description of one entity. */
const graph = [structuredData, website, ...schema];
---

<!doctype html>
{/* en-GB, not en: the copy is British throughout (licence, colour,
    behaviour) and `og:locale` below already says so. They have to agree -
    a screen reader picks its pronunciation rules from this attribute. */}
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    {/* `viewport-fit=cover` or every `env(safe-area-inset-*)` on the site
        resolves to 0 and the notch handling is decorative. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0e0d" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The two core faces, preloaded on every route because both are above
        the fold on every route: Archivo sets the h1 and Inter sets the lead,
        the field labels and every number. Preloading only Inter was measured
        and rejected - it moved FCP from 0.8s to 1.2s and introduced a 0.002
        CLS on three routes, because the h1 then painted in the fallback and
        swapped.

        The two `ext` faces are deliberately NOT preloaded. They cover the
        characters only a name can need, the browser fetches one the moment it
        has to render such a character, and preloading them would spend 51 KB
        on every first paint for glyphs no page currently uses.

        These filenames also appear in the @font-face block at the top of
        global.css; `/fonts/*` is cached immutable for a year, so a new face
        means a new filename. Keep the two lists in step. */}
    <link rel="preload" href="/fonts/archivo-core.latin.v3.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-core.latin.v3.woff2" as="font" type="font/woff2" crossorigin />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.href}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:site_name" content="Artemis Esports" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_GB" />
    {/* Declared dimensions: Slack, Discord and LinkedIn render the card
        faster when they do not have to fetch the file to size it, and some
        of them skip a card they cannot size cheaply. */}
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`Artemis Esports - ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@EsportsArtemis" />

    {
      !noindex && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
        />
      )
    }

    {/* The analytics script is on a third origin, so its DNS lookup, TCP
        handshake and TLS negotiation all happen before the browser has any
        reason to know about it. `preconnect` starts them during head parse
        instead. Only emitted when the tag is - a preconnect to a host this
        build never contacts is a wasted connection, and on a site that
        ships no third-party script by default it would be the only one. */}
    {analyticsEnabled && <link rel="preconnect" href={new URL(umamiSrc).origin} crossorigin />}

    {/* Cookieless analytics, and only when this build was given a website id.
        With the variable unset nothing is requested, nothing is stored, and
        the footer says so. See lib/analytics.ts and DEPLOY.md. */}
    {
      analyticsEnabled && (
        <script defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <span data-nav-sentinel aria-hidden="true"></span>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {cta !== 'none' && <StickyCta intent={cta} />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  /* The sentinel marks "page is at the top"; it must not affect layout.
     64px tall, not 1px: at 1px the header flipped to solid at roughly two
     pixels of scroll and back again, which is a hair trigger on a 200ms
     cross-fade. */
  [data-nav-sentinel] {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 64px;
    pointer-events: none;
  }

  #main:focus {
    outline: none;
  }

  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }
</style>
