---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  /** Optional path to an OG image inside /public, defaults to the brand banner */
  ogImage?: string;
  /** LCP image to preload: pass the getImage() result fields for the hero */
  preload?: { href: string; srcset?: string; sizes?: string };
  /**
   * Set on pages that set tabular figures above the fold (the hero position
   * marker, the roster numbers). The face is fetched on every route anyway,
   * but preloading it where it is *not* above the fold only competes with
   * the LCP image.
   */
  monoBold?: boolean;
  /**
   * A document that is not a page. `dist/404.html` is both Vercel's
   * not-found document and a real file at `/404`, which a host serves with a
   * 200, so without this it is an indexable soft-404 that is not in the
   * sitemap. A not-found document also has no canonical URL and should not
   * assert an organisation.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og.png',
  preload,
  monoBold = false,
  noindex = false,
} = Astro.props;

/* One slash policy, everywhere. Astro emits `/team/` as the page's own
   pathname while every internal link, the sitemap and vercel.json use the
   bare form; served as-is that left two live URLs for one page with only the
   canonical tag to de-duplicate them. The canonical is normalised to the
   form the host actually serves. */
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);

/* One structured-data block, built from the same data the page renders, so a
   search result can show the team and its real channels rather than guessing.
   The `@id` matters: without it the four copies are four anonymous nodes
   instead of one entity described four times. Deliberately not here: the
   roster (the names are flagged as placeholders and must not be published as
   structured claims), the calendar, and any rating. */
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  '@id': new URL('/#organization', Astro.site).href,
  name: site.name,
  alternateName: 'Artemis',
  url: Astro.site?.href,
  description: site.shortDescription,
  sport: ['Sim racing', 'Esports'],
  foundingDate: String(site.founded),
  email: site.contactEmail,
  slogan: site.tagline,
  image: new URL(ogImage, Astro.site).href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.png', Astro.site).href,
    width: 192,
    height: 192,
  },
  sameAs: [...Object.values(site.socials).filter(Boolean), site.store],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* `viewport-fit=cover` or every `env(safe-area-inset-*)` on the site
        resolves to 0 and the notch handling is decorative. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000a08" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/nexa-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nexa-light.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Mono 400 sets the hero proof row and the field labels above the fold
         on every route. Mono 700 sets the position marker and the roster
         numbers, which is above the fold on three routes and below it on two,
         so it is preloaded per page rather than everywhere. -->
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      monoBold && (
        <link
          rel="preload"
          href="/fonts/jetbrains-mono-700.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.href}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:site_name" content="Artemis Esports" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_GB" />
    {/* Declared dimensions: Slack, Discord and LinkedIn render the card
        faster when they do not have to fetch the file to size it, and some
        of them skip a card they cannot size cheaply. */}
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="Artemis Esports - an iRacing endurance, GT and NASCAR oval team"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@EsportsArtemis" />

    {
      !noindex && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <span data-nav-sentinel aria-hidden="true"></span>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  /* The sentinel marks "page is at the top"; it must not affect layout.
     64px tall, not 1px: at 1px the header flipped to solid at roughly two
     pixels of scroll and back again, which is a hair trigger on a 200ms
     cross-fade. The bar now changes once the hero has actually begun to
     leave. */
  [data-nav-sentinel] {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 64px;
    pointer-events: none;
  }

  #main:focus {
    outline: none;
  }

  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }
</style>
