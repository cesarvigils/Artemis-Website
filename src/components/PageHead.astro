---
interface Props {
  title: string;
  lead?: string;
  /** Short data line under the lead, e.g. a roster count. */
  meta?: string;
}

const { title, lead, meta } = Astro.props;

/* The inner pages used to open with a heading in the left 45% and a flat void
   beside it. Each page now puts something real in the right column: an entry
   list, the founding dates, the season summary.
   The aside is rendered up front rather than tested with `slots.has`, because
   a page can pass a slot whose content is conditional on data: with an empty
   drivers.json `has('aside')` is still true and the split would reserve a
   column for nothing. */
const asideHtml = Astro.slots.has('aside') ? await Astro.slots.render('aside') : '';
const hasAside = asideHtml.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const hasAction = Astro.slots.has('action');
---

<section class:list={['page-head', { 'has-aside': hasAside }]}>
  <div class="container page-head-inner">
    <div class="page-head-copy">
      <h1 class="display-xl" data-enter>{title}</h1>
      {
        lead && (
          <p class="lead page-lead" data-enter style="--enter-delay: 120ms">
            {lead}
          </p>
        )
      }
      {
        meta && (
          <p class="page-meta data" data-enter style="--enter-delay: 180ms">
            {meta}
          </p>
        )
      }
      {
        hasAction && (
          <div class="page-action" data-enter style="--enter-delay: 240ms">
            <slot name="action" />
          </div>
        )
      }
    </div>

    {
      hasAside && (
        <div class="page-head-aside" data-enter style="--enter-delay: 220ms">
          <Fragment set:html={asideHtml} />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-head {
    padding-top: calc(var(--nav-h) + var(--space-2xl));
    padding-bottom: var(--space-l);
  }

  .page-head.has-aside {
    padding-bottom: var(--space-xl);
  }

  /* `min(..., 100%)` so the cap can never be wider than the column it sits
     in: at a 200% root font the `em` value alone painted the heading outside
     its own grid cell. */
  .page-head h1 {
    max-width: min(11em, 100%);
  }

  .page-lead {
    margin-top: var(--space-m);
    max-width: var(--measure-lead);
  }

  /* Not `ch`: this line is tracked mono, and `ch` under-measures tracked text
     by roughly a fifth, which orphaned the last two words on every page. */
  .page-meta {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    max-width: 34rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--text-2xs);
    text-wrap: balance;
  }

  .page-action {
    margin-top: var(--space-l);
  }

  /* The split used to start at 901px, which left the copy column at ~450px
     while `.display-xl` was still at its 73px step: the page's own h1
     fragmented into three lines with one word alone in the middle and the
     lead fell to 33.6ch. The grid now starts where the column can carry the
     type it is asked to hold. */
  @media (min-width: 1101px) {
    .page-head.has-aside .page-head-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: var(--space-xl);
      align-items: end;
    }
  }

  /* One band where the split is on but the column is not yet wide enough for
     the top step. The heading takes the step below rather than fragmenting. */
  @media (min-width: 1101px) and (max-width: 1380px) {
    .page-head.has-aside h1 {
      font-size: var(--text-4xl);
    }
  }

  @media (max-width: 1100px) {
    .page-head-aside {
      margin-top: var(--space-l);
    }
  }
</style>
