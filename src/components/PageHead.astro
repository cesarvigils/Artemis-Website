---
interface Props {
  title: string;
  lead?: string;
  /** Short data line under the lead, e.g. a roster count. */
  meta?: string;
  /**
   * The page's position in the site. Pass the SAME array used to build the
   * page's BreadcrumbList, so the trail a reader sees and the trail a
   * crawler reads cannot drift apart - Google's structured-data policy is
   * that markup describes content visible on the page, and a
   * BreadcrumbList with no visible trail is markup describing nothing.
   *
   * The last entry is the current page and carries no `href`. It repeats
   * the h1 directly beneath it, which is the standard shape: at 2xs and
   * muted against a display-size heading the two read as address and
   * title, not as a heading printed twice.
   */
  breadcrumb?: { name: string; href?: string }[];
}

const { title, lead, meta, breadcrumb = [] } = Astro.props;

/* The inner pages used to open with a heading in the left 45% and a flat void
   beside it. Each page now puts something real in the right column: an entry
   list, the founding dates, the season summary.
   The aside is rendered up front rather than tested with `slots.has`, because
   a page can pass a slot whose content is conditional on data: with an empty
   drivers.json `has('aside')` is still true and the split would reserve a
   column for nothing. */
const asideHtml = Astro.slots.has('aside') ? await Astro.slots.render('aside') : '';
const hasAside = asideHtml.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const hasAction = Astro.slots.has('action');
---

<section class:list={['page-head', { 'has-aside': hasAside }]}>
  <div class="container page-head-inner">
    <div class="page-head-copy">
      {
        breadcrumb.length > 1 && (
          <nav class="crumbs" aria-label="Breadcrumb" data-enter>
            <ol>
              {breadcrumb.map((crumb, index) => (
                <li>
                  {crumb.href ? (
                    <a href={crumb.href}>{crumb.name}</a>
                  ) : (
                    <span aria-current="page">{crumb.name}</span>
                  )}
                  {index < breadcrumb.length - 1 && (
                    <span class="crumb-sep" aria-hidden="true">
                      /
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <h1 class="display-xl" data-enter>{title}</h1>
      {
        lead && (
          <p class="lead page-lead" data-enter style="--enter-delay: 60ms">
            {lead}
          </p>
        )
      }
      {
        meta && (
          <p class="page-meta data" data-enter style="--enter-delay: 100ms">
            {meta}
          </p>
        )
      }
      {
        hasAction && (
          <div class="page-action" data-enter style="--enter-delay: 160ms">
            <slot name="action" />
          </div>
        )
      }
    </div>

    {
      hasAside && (
        <div class="page-head-aside" data-enter style="--enter-delay: 120ms">
          <Fragment set:html={asideHtml} />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-head {
    padding-top: calc(var(--nav-h) + var(--space-2xl));
    padding-bottom: var(--space-l);
  }

  .page-head.has-aside {
    padding-bottom: var(--space-xl);
  }

  /* `min(..., 100%)` so the cap can never be wider than the column it sits
     in: at a 200% root font the `em` value alone painted the heading outside
     its own grid cell. */
  .page-head h1 {
    max-width: min(11em, 100%);
  }

  .page-lead {
    margin-top: var(--space-m);
    max-width: var(--measure-lead);
  }

  /* Not `ch`: this line is tracked mono, and `ch` under-measures tracked text
     by roughly a fifth, which orphaned the last two words on every page. */
  /* An address line, deliberately NOT in the field-label register.
     Uppercase + tracked + 2xs is the pit-wall vocabulary for LABELLING A
     VALUE - a column head, a data cell's name. A breadcrumb is neither; it
     is navigation, and dressing it as a data label both misuses the system
     and adds to the one pattern this site already leans on hardest.
     Sentence case, quiet, small. Separators are real text rather than a
     ::before so the trail survives a stylesheet failure and a copy-paste. */
  .crumbs {
    margin-bottom: var(--space-s);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5ch;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .crumbs li {
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 160ms var(--ease), border-color 160ms var(--ease);
  }

  .crumbs a:hover {
    color: var(--mist);
    border-bottom-color: var(--line-strong);
  }

  .crumbs [aria-current='page'] {
    color: var(--mist-dim);
  }

  .crumb-sep {
    color: var(--muted-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .crumbs a {
      transition: none;
    }
  }

  .page-meta {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    max-width: 34rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--text-2xs);
    text-wrap: balance;
  }

  .page-action {
    margin-top: var(--space-l);
  }

  /* The split used to start at 901px, which left the copy column at ~450px
     while `.display-xl` was still at its 73px step: the page's own h1
     fragmented into three lines with one word alone in the middle and the
     lead fell to 33.6ch. The grid now starts where the column can carry the
     type it is asked to hold. */
  @media (min-width: 1101px) {
    .page-head.has-aside .page-head-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: var(--space-xl);
      align-items: end;
    }
  }

  /* One band where the split is on but the column is not yet wide enough for
     the top step. The heading takes the step below rather than fragmenting. */
  @media (min-width: 1101px) and (max-width: 1380px) {
    .page-head.has-aside h1 {
      font-size: var(--text-4xl);
    }
  }

  @media (max-width: 1100px) {
    .page-head-aside {
      margin-top: var(--space-l);
    }
  }
</style>
