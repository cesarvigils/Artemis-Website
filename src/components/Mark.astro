const VIEWBOX = {
  mark: '0 0 232.55 229.4',
  wordmark: '0 0 1249.915 408.738',
  lockup: '0 0 942 334',
}[variant];

const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  class={className}
  viewBox={VIEWBOX}
  xmlns="http://www.w3.org/2000/svg"
  fill="currentColor"
  {...a11y}
>
  {variant === 'mark' && <path d={MARK_PATH} />}
  {variant === 'wordmark' && <path d={WORDMARK_PATH} />}
  {
    variant === 'lockup' && (
      <>
        <path transform="translate(0 0) scale(1.445 1.46)" d={MARK_PATH} />
        <path transform="translate(363 72) scale(0.464 0.462)" d={WORDMARK_PATH} />
      </>
    )
  }
</svg>

<style>
  /* Sized by the parent through --mark-size (custom properties cross
     component boundaries; Astro's scoped classes do not). Colour comes
     from the parent's `color`, since every path is currentColor. */
  svg {
    display: block;
    height: var(--mark-size, 2rem);
    width: auto;
  }
</style>
