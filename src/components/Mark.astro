/**
 * Artemis Gen3 brand marks, inline so they inherit `currentColor`
 * and cost no network request at any size.
 *
 * variant "mark"     - the leaf-and-profile Artemis glyph
 * variant "wordmark" - ARTEMIS / ESPORTS stacked
 * variant "lockup"   - mark + wordmark, horizontally locked
 *
 * Vector source: brand PDF, traced to path data (see DESIGN.md).
 */
interface Props {
  variant?: 'mark' | 'wordmark' | 'lockup';
  /** Accessible name. Omit for decorative use (the SVG is then hidden). */
  label?: string;
  class?: string;
}

const { variant = 'mark', label, class: className } = Astro.props;

