---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { raceDate } from '../lib/format';

interface Props {
  /** Result of getImage() for the hero photo - also preloaded in <head>. */
  image: { src: string; srcSet: { attribute: string } };
  alt: string;
  /**
   * Best finish among the three newest races: the single proof point.
   * Absent only if results.json is emptied, in which case the row is skipped
   * rather than printing a claim with nothing behind it.
   */
  proof?: {
    position: number;
    entries?: number;
    event: string;
    class: string;
    date: string;
  };
  ctaHref: string;
}

const { image, alt, proof, ctaHref } = Astro.props;

const proofDate = proof ? raceDate(proof.date) : '';

/* The position marker is the signature moment: on load it counts down from
   the field size to the finish, the way a timing tower resolves a result.
   Two things make that safe rather than clever:

   1. The finished value is what is in the markup. No JS, a paused tab, a
      headless render or reduced motion all show `P2` on the first frame; the
      script only borrows the number, counts to it and hands it back.
   2. The field is reserved at its widest ("P41", not "P2"), so counting
      cannot shift a single pixel of the row beside it. `--font-mono` is
      tabular, so the reservation is exactly this many character advances. */
const posChars = proof ? String(proof.entries ?? proof.position).length + 1 : 3;
const isPodium = !!proof && proof.position <= 3;
---

<section class="hero">
  <div class="hero-media">
    <img
      src={image.src}
      srcset={image.srcSet.attribute}
      sizes="(max-width: 900px) 130vw, 62vw"
      alt={alt}
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      data-enter-media
    />
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 class="hero-title display-xl">
        <span class="hero-line" data-enter-mask><span>Artemis</span></span>
        <span class="hero-line hero-line-2" data-enter-mask style="--enter-delay: 70ms"
          ><span>Esports</span></span
        >
      </h1>

      <p class="hero-lead lead" data-enter style="--enter-delay: 120ms">
        {site.heroLead}
      </p>

      {
        proof && (
          <p class="hero-proof" data-enter style="--enter-delay: 160ms">
            <span class="hero-pos-block">
              <span
                class:list={['hero-pos', 'data', { 'is-podium': isPodium }]}
                style={`--pos-chars: ${posChars}`}
                data-pos-to={proof.position}
                data-pos-from={proof.entries ?? undefined}
              >
                {/* The counting glyph is decorative while it counts, so it is
                    hidden from assistive tech and the real value sits beside
                    it as text that never changes. No `aria-live`: this is a
                    load-time flourish, not an update the reader asked for. */}
                <span class="hero-pos-value" aria-hidden="true">
                  P{proof.position}
                </span>
                <span class="sr-only">P{proof.position}</span>
                {isPodium && <span class="hero-pos-rule" aria-hidden="true" />}
              </span>
              {proof.entries && <span class="hero-pos-field data">of {proof.entries}</span>}
            </span>
            <span class="hero-proof-body">
              <span class="hero-proof-event">{proof.event}</span>
              <span class="hero-proof-meta data">
                {proof.class} class, {proofDate}
              </span>
            </span>
          </p>
        )
      }

      <div class="hero-actions" data-enter style="--enter-delay: 200ms">
        <a class="btn btn-solid" href={ctaHref} target="_blank" rel="noopener">
          Join the team
          <Icon name="arrow-up-right" size={16} />
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a class="btn btn-ghost" href="#results">
          See results
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: clip;
    padding-top: calc(var(--nav-h) + var(--space-m));
    padding-bottom: var(--space-l);
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: -5% 0 -5% auto;
    width: 64%;
    z-index: -1;
    clip-path: polygon(13% 0, 100% 0, 100% 100%, 0 100%);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 56% center;
  }

  /* Left-to-right scrim: the copy column sits on solid brand black,
     the photo stays legible on the right. */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        100deg,
        var(--bg) 8%,
        rgba(0, 10, 8, 0.88) 36%,
        rgba(0, 10, 8, 0.12) 62%
      ),
      linear-gradient(to top, var(--bg) 2%, transparent 30%);
  }

  .hero-inner {
    width: 100%;
  }

  /* One right edge for the whole stack: the headline, the lead, the proof
     hairline and the button row all stop here. The proof rule used to stop
     32px short of everything else. */
  .hero-copy {
    max-width: 40rem;
  }

  .hero-title {
    line-height: 0.94;
    /* The two-weight lockup is one word per line by design and must never be
       broken mid-word by the global heading backstop. */
    overflow-wrap: normal;
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }

  .hero-line > span {
    display: block;
  }

  .hero-line-2 > span {
    font-weight: 300;
    letter-spacing: var(--track-lockup);
    color: var(--teal);
  }

  /* The claim, not the wordmark, is the sentence that has to land. It sits at
     full ink strength rather than the usual lead step. */
  /* Measured in `ch` so the cap tracks the font instead of a fixed 544px
     against type that grows to 22px. `balance` is what stops the sentence
     dropping two words onto a third line. */
  .hero-lead {
    margin-top: var(--space-m);
    max-width: 45ch;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Proof point: the single most recent result, in the data voice. */
  .hero-proof {
    display: flex;
    align-items: stretch;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .hero-pos-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    padding-right: var(--space-s);
    border-right: 1px solid var(--line-teal);
  }

  /* The field is reserved at the width of the largest number that can ever
     appear in it, so the count cannot move the rule beside it. */
  .hero-pos {
    position: relative;
    display: block;
    min-width: calc(var(--pos-chars, 3) * (1ch + 0.02em));
    padding-bottom: 0.2em;
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1.1;
    color: var(--teal);
  }

  /* The second half of the signature moment: once the number has settled,
     the podium rule draws left to right underneath it. Same primitive as the
     nav underline (scaleX from a left origin), same rule the results sheet
     already puts under a podium position - so the move is new, the
     vocabulary is not.

     Written as a CSS animation with `both`, not a JS-toggled class, so the
     finished state is reached whether or not the module ever runs. */
  .hero-pos-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-pos-rule {
      animation: draw-rule var(--dur-2) var(--ease-out-expo) both;
      /* 160ms (the row's entrance) + 420ms (the count) - the rule lands the
         moment the number stops. */
      animation-delay: 580ms;
    }
  }

  @keyframes draw-rule {
    from {
      transform: scaleX(0);
    }
  }

  .hero-pos-field {
    font-size: var(--text-2xs);
    line-height: 1.1;
    color: var(--ink-faint);
  }

  .hero-proof-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    min-width: 0;
    line-height: var(--leading-snug);
  }

  .hero-proof-event {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .hero-proof-meta {
    color: var(--ink-faint);
    font-size: var(--text-2xs);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  /* Light parallax, transform only, zero JS. Browsers without
     scroll-driven animations simply get a static photo.

     Longhands on purpose: written as the `animation` shorthand, the build
     minifier folds `animation-timeline` into it, and `animation-timeline` is
     not a component of that shorthand, so the browser rejects the whole
     declaration and the parallax silently never runs in a production build. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      html.js .hero-media {
        animation-name: hero-drift;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes hero-drift {
    from {
      transform: translateY(-1.5%);
    }
    to {
      transform: translateY(3.5%);
    }
  }

  @media (max-width: 900px) {
    .hero {
      align-items: flex-end;
      padding-top: calc(var(--nav-h) + var(--space-2xl));
      padding-bottom: var(--space-2xl);
    }

    .hero-media {
      inset: -3% 0;
      width: 100%;
      clip-path: none;
    }

    /* At 390 the frame is a narrow vertical slice of a 16:9 render. The
       horizontal anchor decides whether the car or the run-off is on screen,
       and a 1.3 crop trades the empty hillside at the top of the frame for a
       car that reads at thumb distance. */
    .hero-media img {
      --media-zoom: 1.3;
      object-position: 52% center;
      transform: scale(var(--media-zoom));
      transform-origin: 52% 56%;
    }

    .hero-media::after {
      background: linear-gradient(
        to top,
        var(--bg) 18%,
        rgba(0, 10, 8, 0.86) 42%,
        rgba(0, 10, 8, 0.3) 72%,
        rgba(0, 10, 8, 0.52)
      );
    }

    .hero-actions .btn {
      flex: 1 1 14rem;
    }
  }

  /* A portrait tablet is 1024px tall, so bottom-anchoring the copy put a
     full screen-height of dark hillside above the first word, and the 1.3
     crop - tuned for a 390px frame - only enlarged the hillside. */
  @media (min-width: 701px) and (max-width: 900px) {
    .hero {
      align-items: center;
      padding-top: calc(var(--nav-h) + var(--space-l));
      padding-bottom: var(--space-l);
    }

    .hero-media img {
      --media-zoom: 1.1;
      transform-origin: 50% 62%;
    }
  }

  /* Above 560px the pair of buttons is a pair of buttons, not two slabs. */
  @media (min-width: 561px) and (max-width: 900px) {
    .hero-actions .btn {
      flex: 0 0 auto;
    }
  }

  /* A 320x568 phone could not fit both CTAs on the first screen: the
     secondary one was cut 14px below the fold. Spend the height on the
     content rather than on the reserve above and below it. */
  @media (max-width: 900px) and (max-height: 660px) {
    .hero {
      padding-top: calc(var(--nav-h) + var(--space-s));
      padding-bottom: var(--space-m);
    }

    .hero-actions {
      margin-top: var(--space-m);
      gap: var(--space-2xs);
    }
  }

  /* The scrim is a background-image and Windows High Contrast drops it,
     leaving the copy on a bare photograph. A gradient can never be the
     legibility guarantee; here the photo is decorative, so it goes. */
  @media (forced-colors: active) {
    .hero-media {
      display: none;
    }
  }
</style>
