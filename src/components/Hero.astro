---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { raceDate } from '../lib/format';

interface Props {
  /** Result of getImage() for the hero photo - also preloaded in <head>. */
  image: { src: string; srcSet: { attribute: string } };
  alt: string;
  /** Most recent result, used as the single proof point. */
  proof: {
    position: number;
    event: string;
    class: string;
    date: string;
  };
  ctaHref: string;
}

const { image, alt, proof, ctaHref } = Astro.props;

const proofDate = raceDate(proof.date);
---

<section class="hero">
  <div class="hero-media">
    <img
      src={image.src}
      srcset={image.srcSet.attribute}
      sizes="(max-width: 900px) 100vw, 62vw"
      alt={alt}
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      data-enter-media
    />
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 class="hero-title display-xl">
        <span class="hero-line" data-enter-mask><span>Artemis</span></span>
        <span class="hero-line hero-line-2" data-enter-mask style="--enter-delay: 90ms"
          ><span>Esports</span></span
        >
      </h1>

      <p class="hero-lead lead" data-enter style="--enter-delay: 260ms">
        {site.heroLead}
      </p>

      <p class="hero-proof" data-enter style="--enter-delay: 340ms">
        <span class="hero-pos data">P{proof.position}</span>
        <span class="hero-proof-body">
          <span class="hero-proof-event">{proof.event}</span>
          <span class="hero-proof-meta data">{proof.class} class, {proofDate}</span>
        </span>
      </p>

      <div class="hero-actions" data-enter style="--enter-delay: 420ms">
        <a class="btn btn-solid" href={ctaHref} target="_blank" rel="noopener">
          Join the team
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="btn btn-ghost" href="#results">
          See results
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: clip;
    padding-top: calc(var(--nav-h) + var(--space-m));
    padding-bottom: var(--space-l);
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: -5% 0 -5% auto;
    width: 64%;
    z-index: -1;
    clip-path: polygon(13% 0, 100% 0, 100% 100%, 0 100%);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  /* Left-to-right scrim: the copy column sits on solid brand black,
     the photo stays legible on the right. */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        100deg,
        var(--bg) 8%,
        rgba(0, 10, 8, 0.88) 30%,
        rgba(0, 10, 8, 0.12) 62%
      ),
      linear-gradient(to top, var(--bg) 2%, transparent 30%);
  }

  .hero-inner {
    width: 100%;
  }

  .hero-copy {
    max-width: 36rem;
  }

  .hero-title {
    line-height: 0.94;
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }

  .hero-line > span {
    display: block;
  }

  .hero-line-2 > span {
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--teal);
  }

  .hero-lead {
    margin-top: var(--space-m);
    max-width: 34rem;
  }

  /* Proof point: the single most recent result, in the data voice. */
  .hero-proof {
    display: flex;
    align-items: stretch;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    max-width: 34rem;
  }

  .hero-pos {
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--teal);
    padding-right: var(--space-s);
    border-right: 1px solid var(--line-teal);
  }

  .hero-proof-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    line-height: 1.35;
  }

  .hero-proof-event {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-proof-meta {
    color: var(--ink-faint);
    font-size: var(--text-2xs);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  /* Light parallax, transform only, zero JS. Browsers without
     scroll-driven animations simply get a static photo. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      html.js .hero-media {
        animation: hero-drift linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes hero-drift {
    from {
      transform: translateY(-1.5%);
    }
    to {
      transform: translateY(3.5%);
    }
  }

  @media (max-width: 900px) {
    .hero {
      align-items: flex-end;
      padding-top: calc(var(--nav-h) + var(--space-2xl));
      padding-bottom: var(--space-2xl);
    }

    .hero-media {
      inset: -3% 0;
      width: 100%;
      clip-path: none;
    }

    .hero-media img {
      object-position: 62% center;
    }

    .hero-media::after {
      background: linear-gradient(
        to top,
        var(--bg) 20%,
        rgba(0, 10, 8, 0.9) 46%,
        rgba(0, 10, 8, 0.42) 74%,
        rgba(0, 10, 8, 0.62)
      );
    }

    .hero-actions .btn {
      flex: 1 1 14rem;
    }
  }
</style>
