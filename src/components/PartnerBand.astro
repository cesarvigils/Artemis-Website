---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import partners from '../data/partners.json';

/* Static import per logo - see the note in Garage.astro. */
import glytchWhite from '../assets/partners/glytch-white.png';

const partnerLogos: Record<string, ImageMetadata> = {
  'glytch-white.png': glytchWhite,
};

interface Props {
  /** Heading for the band. */
  heading: string;
  /** One sentence of context above the partner list. */
  lead: string;
  /** Where the quiet link goes, and what it says. */
  link?: { href: string; label: string };
  /**
   * "row"   - one horizontal register, logo first (home).
   * "stack" - heading over the full partner entries (partners page).
   */
  variant?: 'row' | 'stack';
}

const { heading, lead, link, variant = 'row' } = Astro.props;

const list = partners.map((partner) => {
  const meta = partnerLogos[partner.logo];
  if (!meta) {
    throw new Error(
      `partners.json references "${partner.logo}", which has no import in PartnerBand.astro`
    );
  }
  return { ...partner, meta };
});
---

<section
  class:list={['partner-band', `is-${variant}`]}
  aria-labelledby="partner-band-heading"
>
  <div class="container partner-inner">
    {
      variant === 'row' ? (
        <>
          <ul class="partner-marks">
            {list.map((partner) => (
              <li>
                <a href={partner.url} target="_blank" rel="noopener">
                  <Image
                    src={partner.meta}
                    alt={`${partner.name} logo`}
                    widths={[240, 480]}
                    sizes="220px"
                    format="webp"
                    loading="lazy"
                  />
                  <span class="partner-since data">
                    {partner.name}, partner since {partner.since}
                  </span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="partner-copy">
            <h2 class="display-sm" id="partner-band-heading">
              {heading}
            </h2>
            <p class="partner-lead">{lead}</p>
            {link && (
              <a class="text-link" href={link.href}>
                {link.label}
                <Icon name="arrow-right" size={16} />
              </a>
            )}
          </div>
        </>
      ) : (
        <>
          <div class="partner-copy">
            <h2 class="display-md" id="partner-band-heading">
              {heading}
            </h2>
            <p class="partner-lead">{lead}</p>
          </div>
          <ul class="partner-list">
            {list.map((partner) => (
              <li class="partner-item">
                <a href={partner.url} target="_blank" rel="noopener">
                  <Image
                    src={partner.meta}
                    alt={`${partner.name} logo`}
                    widths={[240, 480]}
                    sizes="220px"
                    format="webp"
                    loading="lazy"
                  />
                  <span class="partner-meta">
                    <span class="partner-name">{partner.name}</span>
                    <span class="partner-since data">Partner since {partner.since}</span>
                  </span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
                <p class="partner-blurb">{partner.detail ?? partner.blurb}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  .partner-band {
    background: var(--bg-raise);
    padding-block: var(--space-2xl);
  }

  .partner-lead {
    margin-top: var(--space-s);
    color: var(--ink-dim);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  /* Row variant: one horizontal register. The mark comes first because it is
     the evidence; the sentence and the link follow it on the same line. */
  .is-row .partner-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: var(--space-l) var(--space-xl);
    align-items: center;
    padding-block: var(--space-m);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  .is-row .partner-marks a {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: opacity var(--dur-hover) var(--ease-out);
  }

  .is-row .partner-marks :global(img) {
    width: min(200px, 100%);
    height: auto;
  }

  .is-row .partner-since {
    color: var(--ink-faint);
    font-size: var(--text-2xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .is-row .partner-lead {
    max-width: 54ch;
  }

  .is-row .partner-copy .text-link {
    margin-top: var(--space-m);
  }

  /* Stack variant: the dossier page, where the partner entry carries its own
     paragraph about what the deal actually is. */
  .is-stack .partner-copy h2 {
    max-width: 14ch;
  }

  .is-stack .partner-lead {
    max-width: 40ch;
  }

  .is-stack .partner-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .is-stack .partner-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .is-stack .partner-item {
    border: 1px solid var(--line);
    padding: var(--space-m);
    background: var(--bg);
  }

  .is-stack .partner-item > a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .is-stack .partner-item :global(img) {
    width: 180px;
    height: auto;
  }

  .partner-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .partner-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .is-stack .partner-since {
    color: var(--ink-faint);
    font-size: var(--text-2xs);
  }

  .partner-blurb {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .partner-item > a:hover .partner-name,
    .partner-marks a:hover .partner-since {
      color: var(--teal);
    }
  }

  @media (max-width: 900px) {
    .is-row .partner-inner,
    .is-stack .partner-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .is-stack .partner-item :global(img) {
      width: 140px;
    }
  }
</style>
