---
import nav from '../data/nav.json';
import site from '../data/site.json';
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { channelLinks, isCurrent } from '../lib/links';
import { analyticsEnabled } from '../lib/analytics';

const buildYear = new Date().getFullYear();
const pathname = Astro.url.pathname;

/* One builder, shared with /partners, so the store guard cannot be present in
   one place and missing in the other. */
const channels = channelLinks(site.socials, site.store);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      {/* Tier 1 of the logo system: the wordmark is the workhorse, and the
          header and the footer are exactly where it belongs. */}
      <span class="footer-mark"><Mark variant="wordmark" label="Artemis Esports" /></span>
      <p class="footer-tagline">{site.tagline}</p>
      <a class="footer-email" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h2 class="field-label">Pages</h2>
      <ul>
        {
          nav.footer.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href, pathname) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="field-label">Channels</h2>
      <ul class="footer-channels">
        {
          channels.map((channel) => (
            <li>
              <a
                href={channel.url}
                target="_blank"
                rel="noopener"
                data-umami-event={channel.label === 'Discord' ? 'cta' : undefined}
                data-umami-event-placement={channel.label === 'Discord' ? 'footer' : undefined}
                data-umami-event-audience={channel.label === 'Discord' ? 'driver' : undefined}
              >
                {channel.label}
                <Icon name="arrow-up-right" size={13} />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer-base">
    <p class="footer-copy">
      &copy; <span data-year>{buildYear}</span> Artemis Esports
    </p>
    {/* Legal lives in the base row, not the Pages column: those five are
        what a visitor came for, and burying Join between Privacy and Terms
        would spend the column's attention on the two links nobody opens
        until they need them. */}
    <ul class="footer-legal">
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/terms">Terms</a></li>
    </ul>
    {/* Two states, one sentence each, and the build decides which is true. */}
    <p class="footer-note">
      {
        analyticsEnabled
          ? 'Cookieless analytics, no consent banner.'
          : 'We run no analytics and set no cookies.'
      }
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface-1);
    /* `max(...)`: on a notched phone the base row otherwise sits under the
       home indicator. Needs `viewport-fit=cover` in the meta to resolve to
       anything but 0, which Base.astro sets. */
    padding-block: var(--space-xl) max(var(--space-m), env(safe-area-inset-bottom));
  }

  /* Three columns with the last one pushed to the shell edge, so the footer
     fills its width instead of leaving a hole on the right. */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l) var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  @media (min-width: 821px) {
    .footer-grid > :last-child {
      justify-self: end;
      text-align: right;
    }
  }

  .footer-mark {
    display: block;
    --mark-w: 168px;
    color: var(--mist);
  }

  .footer-tagline {
    margin-top: var(--space-m);
    max-width: 15em;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-display);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    letter-spacing: var(--track-title);
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-2xs);
    /* 26.5px tall before, on the one link that starts a conversation. */
    min-height: 44px;
    padding-block: 0.55rem;
    font-size: var(--text-sm);
    color: var(--mist-dim);
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-2) var(--ease-out-quart),
      border-color var(--dur-2) var(--ease-out-quart),
      opacity var(--dur-1) var(--ease-out-quart);
  }

  .footer-col h2 {
    margin-bottom: var(--space-2xs);
  }

  /* The pitch moves from the link boxes, not from the list gap: 22px links at
     an 11px gap is a 33px pitch and half a touch target. */
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: var(--weight-small);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-xs);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--mist-dim);
    /* At a 200% root font "Instagram" is wider than its column and the footer
       grew a horizontal scrollbar. */
    overflow-wrap: anywhere;
    transition: color var(--dur-2) var(--ease-out-quart),
      opacity var(--dur-1) var(--ease-out-quart);
  }

  .footer-col a[aria-current='page'] {
    color: var(--mist);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-col a:hover,
    .footer-email:hover {
      color: var(--signal);
      border-color: var(--signal);
    }
  }

  /* The colour step the mouse gets, on the keyboard. A focused footer link
     used to sit at its resting colour with only the ring to say so. */
  .footer-col a:focus-visible,
  .footer-email:focus-visible {
    color: var(--signal);
    border-color: var(--signal);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .footer-copy,
  .footer-note,
  .footer-legal {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-small);
  }

  .footer-legal {
    display: flex;
    gap: var(--space-m);
  }

  .footer-legal a {
    transition: color var(--dur-2) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-legal a:hover {
      color: var(--signal-hover);
    }
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-l) var(--space-m);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
