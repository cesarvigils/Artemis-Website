---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import icon from '../assets/logos/Artemis White Logo.png';

const year = new Date().getFullYear();
const socials = Object.entries(site.socials).filter(([, url]) => url);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Image src={icon} alt="Artemis Esports icon" width={72} densities={[1, 2]} />
      <p class="footer-line">{site.tagline}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href="/team">Team</a>
      <a href="/about">About</a>
      <a href="/partners">Partners</a>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </nav>

    <div class="footer-tags">
      {site.hashtags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>

  <div class="container footer-base">
    <p>{year} Artemis Esports. All rights reserved.</p>
    {
      socials.length > 0 && (
        <div class="footer-socials">
          {socials.map(([name, url]) => (
            <a href={url} target="_blank" rel="noopener">
              {name}
            </a>
          ))}
        </div>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
    padding-block: 4rem 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }
  .footer-brand img {
    width: 72px;
    height: auto;
  }
  .footer-line {
    margin-top: 1.25rem;
    color: var(--ink-dim);
    font-size: 0.9375rem;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .footer-nav a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color 200ms ease;
    width: fit-content;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-nav a:hover {
      color: var(--teal);
    }
  }
  .footer-tags {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: flex-start;
  }
  .footer-tags span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--teal-dim);
  }
  .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .footer-base p {
    color: var(--ink-faint);
    font-size: 0.875rem;
  }
  .footer-socials {
    display: flex;
    gap: 1.5rem;
  }
  .footer-socials a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-socials a:hover {
      color: var(--teal);
    }
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-base {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
