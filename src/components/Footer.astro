---
import nav from '../data/nav.json';
import site from '../data/site.json';
import Mark from './Mark.astro';
import Icon from './Icon.astro';

const buildYear = new Date().getFullYear();

const SOCIAL_LABELS: Record<string, string> = {
  discord: 'Discord',
  x: 'X',
  instagram: 'Instagram',
  tiktok: 'TikTok',
  youtube: 'YouTube',
  twitch: 'Twitch',
};

const channels = [
  ...Object.entries(site.socials)
    .filter(([, url]) => url)
    .map(([key, url]) => ({ label: SOCIAL_LABELS[key] ?? key, url })),
  ...(site.store ? [{ label: 'Store', url: site.store }] : []),
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="footer-mark"><Mark variant="mark" label="Artemis Esports" /></span>
      <p class="footer-tagline">{site.tagline}</p>
      <a class="footer-email" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h2 class="field-label">Pages</h2>
      <ul>
        {nav.footer.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="field-label">Channels</h2>
      <ul class="footer-channels">
        {
          channels.map((channel) => (
            <li>
              <a href={channel.url} target="_blank" rel="noopener">
                {channel.label}
                <Icon name="arrow-up-right" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer-base">
    <p class="footer-copy">
      &copy; <span data-year>{buildYear}</span> Artemis Esports. All rights reserved.
    </p>
    <p class="footer-hash data">{site.hashtags[0]}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
    padding-block: var(--space-xl) var(--space-m);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-l) var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .footer-mark {
    display: block;
    --mark-size: 52px;
    color: var(--teal);
  }

  .footer-tagline {
    margin-top: var(--space-m);
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .footer-email {
    display: inline-block;
    margin-top: var(--space-s);
    font-size: var(--text-sm);
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out);
  }

  .footer-col h2 {
    margin-bottom: var(--space-s);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color var(--dur-hover) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-col a:hover,
    .footer-email:hover {
      color: var(--teal);
      border-color: var(--teal);
    }
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .footer-copy {
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }

  .footer-hash {
    color: var(--teal-soft);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-l) var(--space-m);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
