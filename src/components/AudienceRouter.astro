---
/**
 * The three things a visitor can be here for, pointed at the page that
 * answers them. It sits directly under the next-race strip because that is
 * the first moment the reader has seen enough to know which of the three
 * they are.
 *
 * A SIGNPOST, ON ONE LINE
 *   This used to be three equal columns, each with a label and a sentence
 *   under it. The comment here already said "a router, not a feature grid",
 *   but three equal thirds with body copy in them IS a feature grid however
 *   it is described, and the home page carried four such triads - which
 *   DESIGN.md section 1 lists as deliberately absent and forbids twice on
 *   one page.
 *
 *   The sentences are gone rather than restyled, because they were already
 *   on the page: "every race goes public within 48 hours" is the first
 *   pillar, in nearly the same words, three sections below. A signpost
 *   names directions; it does not re-argue them. Widths are content-sized,
 *   so this can never read as thirds again.
 */
const ROUTES = [
  { href: '/#scoreboard', label: 'Follow the team' },
  { href: '/join', label: 'Race for us' },
  { href: '/partners', label: 'Partner with us' },
];
---

<nav class="router rule-top" aria-label="Where to go next">
  <div class="container">
    <ul class="router-list">
      {
        ROUTES.map((route) => (
          <li>
            <a class="router-link" href={route.href}>
              <span class="router-label">{route.label}</span>
              <span class="router-arrow" aria-hidden="true">
                &#8594;
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .router {
    padding-block: var(--space-s);
  }

  /* Flex, not grid: the items are sized by their own words. That is the
     whole point - a grid of `1fr`s is what made this read as thirds. */
  .router-list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .router-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6ch;
    min-height: 44px;
    padding-block: var(--space-xs);
    transition: color var(--dur-2) var(--ease-out-quart);
  }

  .router-label {
    font-family: var(--font-display);
    font-weight: var(--weight-small);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-sm);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    color: var(--mist);
    transition: color var(--dur-2) var(--ease-out-quart);
  }

  /* The arrow carries the hover, so the label is not the only thing moving
     and the direction is legible before the pointer arrives. */
  .router-arrow {
    color: var(--muted);
    font-size: var(--text-sm);
    transform: translateX(0);
    transition: transform var(--dur-2) var(--ease-out-quart),
      color var(--dur-2) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .router-link:hover .router-label,
    .router-link:hover .router-arrow {
      color: var(--signal);
    }
    .router-link:hover .router-arrow {
      transform: translateX(0.25rem);
    }
  }

  .router-link:focus-visible .router-label,
  .router-link:focus-visible .router-arrow {
    color: var(--signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .router-arrow {
      transition: color var(--dur-2) var(--ease-out-quart);
    }
    .router-link:hover .router-arrow {
      transform: none;
    }
  }

  /* Below 560px the three wrap to their own lines on their own, without a
     column rule to remove or a grid to collapse. */
  @media (max-width: 560px) {
    .router-list {
      gap: 0;
    }
    .router-link {
      padding-block: var(--space-xs);
    }
  }
</style>
