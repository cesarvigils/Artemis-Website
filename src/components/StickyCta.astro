---
import Icon from './Icon.astro';
import { CTA_INTENTS } from '../lib/links';

interface Props {
  /** Which action this page is for. Same keys as CTA_INTENTS. */
  intent?: string;
}

const { intent = 'join' } = Astro.props;
const cta = CTA_INTENTS[intent] ?? CTA_INTENTS.join;
---

{/* Phone only. The bar arrives once the first screen has scrolled away, and
    leaves again when the footer (which carries the same links) is in view,
    so the reader is never offered the action twice at once at the foot of
    the page. It is `visibility: hidden` at rest, so it is out of the tab
    order and out of the accessibility tree until it is really there, and it
    is `position: fixed`, so it can never move the document: measured CLS 0.
*/}
<div class="sticky-cta" data-sticky-cta>
  <a
    class="btn btn-solid sticky-btn"
    href={cta.href}
    target={cta.external ? '_blank' : undefined}
    rel={cta.external ? 'noopener' : undefined}
    data-umami-event="cta"
    data-umami-event-placement="sticky"
    data-umami-event-audience={cta.audience}
  >
    {cta.label}
    <Icon name={cta.external ? 'arrow-up-right' : 'arrow-right'} size={16} />
    {cta.external && <span class="sr-only"> (opens in a new tab)</span>}
  </a>
</div>

<style>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 820px) {
    .sticky-cta {
      position: fixed;
      inset: auto 0 0;
      z-index: var(--z-sticky);
      display: block;
      padding: 0 max(var(--pad-x), env(safe-area-inset-left))
        env(safe-area-inset-bottom) max(var(--pad-x), env(safe-area-inset-right));
      background: var(--night);
      border-top: 1px solid var(--line);
      /* Transform only, and it starts fully off the bar's own box rather
         than from `scale(0)` or from nothing: the bar slides up from under
         the edge of the screen, which is where it came from. */
      transform: translateY(100%);
      visibility: hidden;
      transition: transform var(--dur-2) var(--ease-out-expo),
        visibility 0s linear var(--dur-2);
    }

    .sticky-cta.is-shown {
      transform: translateY(0);
      visibility: visible;
      transition: transform var(--dur-2) var(--ease-out-expo), visibility 0s;
    }

    /* The panel covers the page; the bar under it would be a second action
       floating over the navigation. */
    :global(html.menu-open) .sticky-cta {
      transform: translateY(100%);
      visibility: hidden;
    }

    /* 56px including the hairline, which is the cap. The button's own
       padding would make it 52px; the explicit height is what keeps the bar
       from growing when the label wraps at a 200% root font - it scrolls the
       label instead of eating the screen. */
    .sticky-btn {
      display: flex;
      width: 100%;
      height: 55px;
      min-height: 0;
      padding-inline: var(--space-s);
      font-size: var(--text-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
    .sticky-cta.is-shown {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .sticky-cta {
      background: Canvas;
      border-top: 1px solid CanvasText;
    }
  }
</style>
