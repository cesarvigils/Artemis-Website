---
import site from '../data/site.json';

interface Props {
  heading: string;
  lead?: string;
  /**
   * "row"  - the three commitments across one band (home).
   * "long" - the same three, one per row, with more room for the test.
   */
  variant?: 'row' | 'long';
}

const { heading, lead, variant = 'row' } = Astro.props;
---

{/* Three commitments, each with the test anyone can run against it. The test
    is the point: a value with no test is a slogan, and the brand core writes
    all three as behaviours. */}
<section class:list={['pillars', `is-${variant}`]} aria-labelledby="pillars-heading">
  <div class="container">
    <div class="pillars-head">
      <h2 class:list={[variant === 'long' ? 'display-md' : 'display-lg']} id="pillars-heading">
        {heading}
      </h2>
      {lead && <p class="lead">{lead}</p>}
    </div>

    <dl class="pillars-list">
      {
        site.pillars.map((pillar, i) => (
          <div class="pillar reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <dt>{pillar.title}</dt>
            <dd class="pillar-line">{pillar.line}</dd>
            <dd class="pillar-test">{pillar.test}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .pillars {
    background: var(--surface-1);
    padding-block: var(--space-2xl);
  }

  .pillars-head .lead {
    margin-top: var(--space-s);
    max-width: var(--measure-lead);
  }

  .pillar dt {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
  }

  .pillar-line {
    color: var(--mist-dim);
    line-height: var(--leading-body);
  }

  /* The test sits below the commitment in the caption colour, because it is
     metadata about the claim rather than the claim. */
  .pillar-test {
    margin-top: var(--space-2xs);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* Row variant: the heading sits on its own line and the three commitments
     run across the band as one horizontal register. Three across rather than
     the old four is also why no title reserve is needed any more: the titles
     are one line each in a third of the band at every width it is
     horizontal. */
  .is-row .pillars-head h2 {
    max-width: 16em;
  }

  .is-row .pillars-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-xl);
    border-top: 1px solid var(--line-strong);
  }

  .is-row .pillar {
    display: flex;
    flex-direction: column;
    padding: var(--space-m) var(--space-m) 0 0;
  }

  .is-row .pillar + .pillar {
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }

  .is-row .pillar dt {
    font-size: var(--text-lg);
  }

  .is-row .pillar-line {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
  }

  /* `margin-top: auto` on the test: three commitments of different sentence
     length would otherwise start their test lines at three different
     heights, with full-height hairlines between the columns to make it
     obvious. The tests share a baseline instead. */
  .is-row .pillar-test {
    margin-top: auto;
    padding-top: var(--space-s);
  }

  /* Long variant: one entry per row, the title held against the commitment
     and its test. */
  .is-long .pillars-head h2 {
    max-width: 11em;
  }

  .is-long .pillars-list {
    margin-top: var(--space-l);
  }

  .is-long .pillar {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.6fr);
    gap: var(--space-xs) var(--space-l);
    align-items: baseline;
    padding-block: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .is-long .pillar:last-child {
    border-bottom: 1px solid var(--line);
  }

  .is-long .pillar dt {
    font-size: var(--text-xl);
  }

  .is-long .pillar-line {
    font-size: var(--text-base);
    color: var(--mist);
  }

  .is-long .pillar-test {
    grid-column: 2;
    margin-top: 0.4rem;
  }

  @media (max-width: 1024px) {
    .is-row .pillars-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .is-row .pillar:nth-child(3) {
      margin-top: var(--space-m);
      border-top: 1px solid var(--line);
    }
    /* Same selector shape as the rule it overrides, so source order decides.
       Written as `.is-row .pillar:nth-child(3)` it was (0,4,0) against the
       across-the-band rule's (0,5,0) and never applied: the second row kept a
       24px indent and a vertical hairline with nothing to its left. */
    .is-row .pillar + .pillar:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }
  }

  /* The long variant kept two columns down to 640px, so on a portrait tablet
     a 24px title sat in a 279px cell beside a 388px sentence and the two
     halves never settled into a ratio. It stacks where the page head does. */
  @media (max-width: 900px) {
    .is-long .pillar {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .is-long .pillar-test {
      grid-column: 1;
    }
  }

  @media (max-width: 640px) {
    .is-row .pillars-list {
      grid-template-columns: 1fr;
    }
    .is-row .pillar + .pillar {
      padding-left: 0;
      margin-top: 0;
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .is-row .pillar-test {
      margin-top: var(--space-2xs);
      padding-top: var(--space-2xs);
    }
  }
</style>
