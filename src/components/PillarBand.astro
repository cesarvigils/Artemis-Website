---
import site from '../data/site.json';

interface Props {
  heading: string;
  lead?: string;
  /**
   * "row"  - the three commitments across one band (home).
   * "long" - the same three, one per row, with more room for the test.
   */
  variant?: 'row' | 'long';
}

const { heading, lead, variant = 'row' } = Astro.props;
---

{/* Three commitments, each with the test anyone can run against it. The test
    is the point: a value with no test is a slogan, and the brand core writes
    all three as behaviours. */}
<section class:list={['pillars', `is-${variant}`]} aria-labelledby="pillars-heading">
  <div class="container">
    <div class="pillars-head">
      <h2 class:list={[variant === 'long' ? 'display-md' : 'display-lg']} id="pillars-heading">
        {heading}
      </h2>
      {lead && <p class="lead">{lead}</p>}
    </div>

    <dl class="pillars-list">
      {
        site.pillars.map((pillar, i) => (
          <div class="pillar reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <dt>{pillar.title}</dt>
            <dd class="pillar-line">{pillar.line}</dd>
            <dd class="pillar-test">{pillar.test}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .pillars {
    background: var(--surface-1);
    /* A statement, not a table: the most open band on the page.
       Matches `.section-tall`. */
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .pillars-head .lead {
    margin-top: var(--space-s);
    max-width: var(--measure-lead);
  }

  .pillar dt {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
  }

  .pillar-line {
    color: var(--mist-dim);
    line-height: var(--leading-body);
  }

  /* The test sits below the commitment in the caption colour, because it is
     metadata about the claim rather than the claim. */
  .pillar-test {
    margin-top: var(--space-2xs);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* ROW VARIANT - stacked statement bands, not three columns.
     This used to be `repeat(3, 1fr)`, which put the brand's three
     commitments in small type in a third of the band each. Two problems.
     DESIGN.md section 1 lists equal card grids as deliberately absent and
     allows no layout family twice on a page, and the home page was running
     four equal triads. And thirds are the wrong emphasis for the section
     that states what the team promises: it was the quietest band on a page
     whose loudest thing is a results table.

     So each commitment gets the full measure and display type. Distinct
     from the `long` variant below, which holds a small title in a left
     column beside its text, and from the Scoreboard, whose rows are dense
     tabular data rather than statements. No column rules to unwind at
     small widths either - it is already one column. */
  .is-row .pillars-head h2 {
    max-width: 16em;
  }

  .is-row .pillars-list {
    margin-top: var(--space-l);
  }

  .is-row .pillar {
    padding-block: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .is-row .pillar:first-child {
    border-top-color: var(--line-strong);
  }

  .is-row .pillar:last-child {
    border-bottom: 1px solid var(--line);
  }

  .is-row .pillar dt {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
  }

  .is-row .pillar-line {
    margin-top: var(--space-2xs);
    max-width: var(--measure-lead);
    font-size: var(--text-lg);
    color: var(--mist);
    line-height: var(--leading-snug);
  }

  /* The test keeps the caption colour and the hairline above it: it is
     metadata about the claim, and at this size the claim needs the
     separation more, not less. */
  .is-row .pillar-test {
    margin-top: var(--space-s);
    padding-top: var(--space-xs);
    max-width: var(--measure-lead);
  }

  /* Long variant: one entry per row, the title held against the commitment
     and its test. */
  .is-long .pillars-head h2 {
    max-width: 11em;
  }

  .is-long .pillars-list {
    margin-top: var(--space-l);
  }

  .is-long .pillar {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.6fr);
    gap: var(--space-xs) var(--space-l);
    align-items: baseline;
    padding-block: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .is-long .pillar:last-child {
    border-bottom: 1px solid var(--line);
  }

  .is-long .pillar dt {
    font-size: var(--text-xl);
  }

  .is-long .pillar-line {
    font-size: var(--text-base);
    color: var(--mist);
  }

  .is-long .pillar-test {
    grid-column: 2;
    margin-top: 0.4rem;
  }

  /* The long variant kept two columns down to 640px, so on a portrait tablet
     a 24px title sat in a 279px cell beside a 388px sentence and the two
     halves never settled into a ratio. It stacks where the page head does. */
  @media (max-width: 900px) {
    .is-long .pillar {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .is-long .pillar-test {
      grid-column: 1;
    }
  }

</style>
