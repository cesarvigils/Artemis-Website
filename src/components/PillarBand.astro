---
import site from '../data/site.json';

interface Props {
  heading: string;
  lead?: string;
  /**
   * "row"  - four short rules across one band (home).
   * "long" - the same four with a sentence each about a race weekend (about).
   */
  variant?: 'row' | 'long';
  /** Print the team hashtags along the foot of the band. */
  hashtags?: boolean;
}

const { heading, lead, variant = 'row', hashtags = false } = Astro.props;
---

<section class:list={['pillars', `is-${variant}`]} aria-labelledby="pillars-heading">
  <div class="container">
    <div class="pillars-head">
      <h2 class:list={[variant === 'long' ? 'display-md' : 'display-lg']} id="pillars-heading">
        {heading}
      </h2>
      {lead && <p class="lead">{lead}</p>}
    </div>

    <dl class="pillars-list">
      {
        site.pillars.map((pillar, i) => (
          <div class="pillar reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <dt>{pillar.title}</dt>
            <dd>{pillar.line}</dd>
            {variant === 'long' && pillar.detail && <dd class="pillar-detail">{pillar.detail}</dd>}
          </div>
        ))
      }
    </dl>

    {
      hashtags && (
        <ul class="pillar-tags">
          {site.hashtags.map((tag) => (
            <li class="data">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .pillars {
    background: var(--bg-raise);
    padding-block: var(--space-2xl);
  }

  .pillars-head .lead {
    margin-top: var(--space-s);
    max-width: var(--measure-lead);
  }

  .pillar dt {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
  }

  .pillar dd {
    color: var(--ink-dim);
    line-height: var(--leading-body);
  }

  /* Row variant: the heading sits on its own line and the four rules run
     across the band as one horizontal register. No narrow copy column,
     no tall empty gutter beside a short list. */
  .is-row .pillars-head h2 {
    max-width: 16em;
  }

  .is-row .pillars-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--space-xl);
    border-top: 1px solid var(--line-strong);
  }

  .is-row .pillar {
    padding: var(--space-m) var(--space-m) 0 0;
  }

  .is-row .pillar + .pillar {
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }

  .is-row .pillar dt {
    font-size: var(--text-lg);
  }

  .is-row .pillar dd {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
  }

  /* Long variant: one entry per row, the title held against the sentence
     that explains what it costs on a race weekend. */
  .is-long .pillars-head h2 {
    max-width: 11em;
  }

  .is-long .pillars-list {
    margin-top: var(--space-l);
  }

  .is-long .pillar {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.6fr);
    gap: var(--space-xs) var(--space-l);
    align-items: baseline;
    padding-block: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .is-long .pillar:last-child {
    border-bottom: 1px solid var(--line);
  }

  .is-long .pillar dt {
    font-size: var(--text-xl);
  }

  .is-long .pillar dd {
    font-size: var(--text-base);
    color: var(--ink);
  }

  .is-long .pillar-detail {
    grid-column: 2;
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--ink-dim);
  }

  /* The tags belong to the values, so they run along the foot of the band
     rather than filling a section of their own. */
  .pillar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .pillar-tags li {
    color: var(--teal-soft);
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-label);
    /* "#FOLLOWERSOFTHEHUNT" is one unbreakable 19-character token and at a
       200% root font it is wider than a 390px phone. */
    overflow-wrap: anywhere;
  }

  @media (max-width: 1024px) {
    .is-row .pillars-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .is-row .pillar:nth-child(3),
    .is-row .pillar:nth-child(4) {
      margin-top: var(--space-m);
      border-top: 1px solid var(--line);
    }
    /* Same selector shape as the rule it overrides, so source order decides.
       Written as `.is-row .pillar:nth-child(3)` it was (0,4,0) against the
       four-across rule's (0,5,0) and never applied: row two of the register
       kept a 24px indent and a vertical hairline with nothing to its left. */
    .is-row .pillar + .pillar:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }
  }

  /* The long variant kept two columns down to 640px, so on a portrait tablet
     a 24px title sat in a 279px cell beside a 388px sentence and the two
     halves never settled into a ratio. It stacks where the page head does. */
  @media (max-width: 900px) {
    .is-long .pillar {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .is-long .pillar-detail {
      grid-column: 1;
    }
  }

  @media (max-width: 640px) {
    .is-row .pillars-list {
      grid-template-columns: 1fr;
    }
    .is-row .pillar + .pillar {
      padding-left: 0;
      margin-top: 0;
      border-left: none;
      border-top: 1px solid var(--line);
    }
  }
</style>
