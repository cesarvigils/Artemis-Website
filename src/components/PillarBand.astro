---
import site from '../data/site.json';

interface Props {
  heading: string;
  lead?: string;
}

const { heading, lead } = Astro.props;
---

<section class="pillars rule-top" aria-labelledby="pillars-heading">
  <div class="container pillars-inner">
    <div class="pillars-copy">
      <h2 class="display-md" id="pillars-heading">{heading}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>

    <dl class="pillars-list">
      {
        site.pillars.map((pillar) => (
          <div class="pillar reveal">
            <dt>{pillar.title}</dt>
            <dd>{pillar.line}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .pillars {
    padding-block: var(--space-2xl);
  }

  .pillars-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .pillars-copy h2 {
    max-width: 12ch;
  }

  .pillars-copy .lead {
    margin-top: var(--space-s);
    max-width: 32ch;
  }

  .pillars-list {
    display: flex;
    flex-direction: column;
  }

  .pillar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: var(--space-xs) var(--space-l);
    align-items: baseline;
    padding-block: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .pillar:last-child {
    border-bottom: 1px solid var(--line);
  }

  .pillar dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .pillar dd {
    color: var(--ink-dim);
    font-size: var(--text-base);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .pillars-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .pillar {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
