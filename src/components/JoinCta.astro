---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { CTA_INTENTS } from '../lib/links';

interface Props {
  /** Defaults to the motto, which is the one place on the site it appears. */
  heading?: string;
  lead?: string;
  /** Show the three-step explainer. Off on pages that already explain it. */
  steps?: boolean;
  /** Which wording of the same Discord action this page uses. */
  intent?: 'join' | 'apply';
}

const {
  heading = site.motto,
  lead = site.join.lead,
  steps = true,
  intent = 'join',
} = Astro.props;
const cta = CTA_INTENTS[intent];
---

{/* The band's ground is material grain at 4% (see `.grain` in global.css),
    which is what replaced the graffiti texture: an inline feTurbulence tile,
    no raster asset, no request, and nothing that reads as vandalism. */}
<section class="join grain rule-top" aria-labelledby="join-heading" id="join">
  <div class="container join-inner">
    <h2 class="display-xl join-heading" id="join-heading">{heading}</h2>
    <p class="lead join-lead">{lead}</p>
    <a
      class="btn btn-solid join-btn"
      href={cta.href}
      target="_blank"
      rel="noopener"
      data-umami-event="cta"
      data-umami-event-placement="join"
      data-umami-event-audience={cta.audience}
    >
      {cta.label}
      <Icon name="arrow-up-right" size={16} />
      <span class="sr-only"> (opens in a new tab)</span>
    </a>

    {
      steps && (
        <ol class="join-steps">
          {site.join.steps.map((step, i) => (
            <li class="reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <span class="step-index data">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-title">{step.title}</span>
              <span class="step-line">{step.line}</span>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</section>

<style>
  .join {
    position: relative;
    overflow: clip;
    padding-block: var(--space-3xl);
    isolation: isolate;
  }

  /* The band's own ground, a step up from Night so the grain has something
     to sit on. The grain itself is `.grain::before` in global.css. */
  .join {
    background: var(--surface-1);
  }

  /* The band runs the full width: heading, then the sentence, then the
     action, then what happens after it. No narrow copy column. */
  .join-heading {
    max-width: 9em;
  }

  .join-lead {
    margin-top: var(--space-m);
    max-width: var(--measure-lead);
    color: var(--mist);
  }

  .join-btn {
    margin-top: var(--space-l);
  }

  /* A real three-step sequence, so the numbers carry information. It runs
     left to right under the button, in the order it happens. */
  .join-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line-strong);
  }

  .join-steps li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-m) var(--space-l) 0 0;
  }

  .join-steps li + li {
    padding-left: var(--space-l);
    border-left: 1px solid var(--line);
  }

  .step-index {
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    line-height: 1;
    color: var(--muted);
  }

  /* Explicit: inheriting the body's leading made this title lead looser than
     the sentence underneath it. */
  .step-title {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-base);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
  }

  .step-line {
    color: var(--mist-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    max-width: 32ch;
  }

  @media (max-width: 900px) {
    .join-steps {
      grid-template-columns: 1fr;
      margin-top: var(--space-xl);
    }
    .join-steps li {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem var(--space-s);
      padding: var(--space-m) 0;
    }
    .join-steps li + li {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .step-index {
      font-size: var(--text-lg);
    }
    .step-title {
      margin-top: 0;
    }
    .step-line {
      flex: 1 0 100%;
      max-width: none;
    }
  }

  /* A full-width button is right on a phone and wrong on a 706px tablet,
     where it became a 706x52px slab around a 13-character label. */
  @media (max-width: 560px) {
    .join-btn {
      width: 100%;
    }
  }
</style>
