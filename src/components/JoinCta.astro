---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { discordInvite } from '../lib/links';
import texture from '../assets/hunt-texture.jpg';

interface Props {
  heading?: string;
  lead?: string;
  /** Show the three-step explainer. Off on pages that already explain it. */
  steps?: boolean;
}

const { heading = 'On the hunt.', lead = site.join.lead, steps = true } = Astro.props;
---

<section class="join rule-top" aria-labelledby="join-heading" id="join">
  <div class="join-texture" aria-hidden="true">
    <Image
      src={texture}
      alt=""
      widths={[400, 800, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={55}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="container join-inner">
    <h2 class="display-xl join-heading" id="join-heading">{heading}</h2>
    <p class="lead join-lead">{lead}</p>
    <a class="btn btn-solid join-btn" href={discordInvite} target="_blank" rel="noopener">
      Join the team
      <Icon name="arrow-up-right" size={16} />
      <span class="sr-only"> (opens in a new tab)</span>
    </a>

    {
      steps && (
        <ol class="join-steps">
          {site.join.steps.map((step, i) => (
            <li class="reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <span class="step-index data">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-title">{step.title}</span>
              <span class="step-line">{step.line}</span>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</section>

<style>
  .join {
    position: relative;
    overflow: clip;
    padding-block: var(--space-3xl);
    isolation: isolate;
  }

  /* The brand's own spray texture, not a decorative gradient. */
  .join-texture {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* :global: the <img> comes from Astro's Image component. */
  .join-texture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .join-texture::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--bg) 12%,
      rgba(0, 10, 8, 0.86) 46%,
      rgba(0, 10, 8, 0.72)
    );
  }

  /* The band runs the full width: heading, then the sentence, then the
     action, then what happens after it. No narrow copy column. */
  .join-heading {
    max-width: 9em;
  }

  .join-lead {
    margin-top: var(--space-m);
    max-width: var(--measure-lead);
    color: var(--ink);
  }

  .join-btn {
    margin-top: var(--space-l);
  }

  /* A real three-step sequence, so the numbers carry information. It runs
     left to right under the button, in the order it happens. */
  .join-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line-strong);
  }

  .join-steps li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-m) var(--space-l) 0 0;
  }

  .join-steps li + li {
    padding-left: var(--space-l);
    border-left: 1px solid var(--line);
  }

  .step-index {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    color: var(--teal);
  }

  /* Explicit: inheriting the body's leading made this title lead looser than
     the sentence underneath it. */
  .step-title {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
  }

  .step-line {
    color: var(--ink-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    max-width: 32ch;
  }

  @media (max-width: 900px) {
    .join-texture::after {
      background: linear-gradient(
        to top,
        var(--bg) 10%,
        rgba(0, 10, 8, 0.82) 55%,
        rgba(0, 10, 8, 0.7)
      );
    }
    .join-steps {
      grid-template-columns: 1fr;
      margin-top: var(--space-xl);
    }
    .join-steps li {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem var(--space-s);
      padding: var(--space-m) 0;
    }
    .join-steps li + li {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .step-index {
      font-size: var(--text-lg);
    }
    .step-title {
      margin-top: 0;
    }
    .step-line {
      flex: 1 0 100%;
      max-width: none;
    }
  }

  /* A full-width button is right on a phone and wrong on a 706px tablet,
     where it became a 706x52px slab around a 13-character label. */
  @media (max-width: 560px) {
    .join-btn {
      width: 100%;
    }
  }

  /* The scrim over the HUNT texture is a background-image, so high contrast
     strips it and the copy lands on the spray. The texture is decorative. */
  @media (forced-colors: active) {
    .join-texture {
      display: none;
    }
  }
</style>
