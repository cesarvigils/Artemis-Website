---
/**
 * One car in the garage carousel. The <Image> itself is passed in as a
 * slot from Garage.astro so that its `src` stays a plain imported
 * identifier - that is what lets Astro ship the webp derivative only.
 */
interface Props {
  car: string;
  track: string;
  caption: string;
  shape?: string;
}

const { car, track, caption, shape = 'standard' } = Astro.props;
---

<li class:list={['garage-slide', `is-${shape}`]}>
  <figure>
    <div class="garage-frame"><slot /></div>
    <figcaption>
      <span class="slide-car">{car}</span>
      <span class="slide-track data">{track}</span>
      <span class="slide-caption">{caption}</span>
    </figcaption>
  </figure>
</li>

<style>
  /* Filmstrip: every frame is the same height so the captions line up,
     and the widths vary with each shot's own proportion. */
  .garage-slide {
    --frame-h: clamp(15rem, 24vw, 22rem);
    flex: 0 0 auto;
    width: calc(var(--frame-h) * 16 / 9);
    scroll-snap-align: start;
  }

  /* A floor, because the slide also has to hold its own caption: derived
     purely from the frame height, the portrait slide was 196px at 1024 and
     its caption measured 20.6ch beside a 46ch caption in the same row. */
  .garage-slide.is-portrait {
    width: max(15rem, calc(var(--frame-h) * 4 / 5));
  }

  .garage-slide.is-wide {
    width: calc(var(--frame-h) * 21 / 9);
  }

  .garage-frame {
    height: var(--frame-h);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-raise);
  }

  /* No hover zoom. The slide is a figure, not a link: there is nothing to
     click, and a frame that scales under the cursor promises one. The
     results sheet refuses a row hover for exactly this reason, and the
     design notes list "hover states on rows that are not clickable" as
     deliberately absent - one rule, applied in both places. The affordance
     for this strip is the strip: it scrolls, and it has arrows. */
  .garage-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: var(--space-s);
  }

  .slide-car {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    color: var(--teal);
    overflow-wrap: anywhere;
  }

  .slide-track {
    color: var(--ink-faint);
    font-size: var(--text-2xs);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    overflow-wrap: anywhere;
  }

  /* The other half of the same problem: without a cap the caption measure is
     whatever the photograph's aspect ratio happens to give it, so the wide
     slide ran to 55ch beside the portrait's 21ch. */
  .slide-caption {
    margin-top: 0.15rem;
    max-width: 40ch;
    font-size: var(--text-sm);
    color: var(--ink-dim);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  /* Below 900px the frame is width-driven instead, so a slide always
     fits the screen and the shots keep their own proportion. */
  @media (max-width: 900px) {
    .garage-slide,
    .garage-slide.is-wide {
      width: 84vw;
    }
    .garage-slide.is-portrait {
      width: 68vw;
    }
    .garage-frame {
      height: auto;
      aspect-ratio: 16 / 9;
    }
    .garage-slide.is-portrait .garage-frame {
      aspect-ratio: 4 / 5;
    }
    .garage-slide.is-wide .garage-frame {
      aspect-ratio: 21 / 9;
    }
  }
</style>
