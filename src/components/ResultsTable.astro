---
import { raceDate } from '../lib/format';
import type { RaceResult } from '../lib/data';

interface Props {
  results: RaceResult[];
  caption: string;
}

const { results, caption } = Astro.props;
---

<table class="results" role="table">
  <caption class="sr-only">{caption}</caption>
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col" class="field-label col-pos">Pos</th>
      <th role="columnheader" scope="col" class="field-label col-event">Event</th>
      <th role="columnheader" scope="col" class="field-label col-class">Class</th>
      <th role="columnheader" scope="col" class="field-label col-driver">Drivers</th>
      <th role="columnheader" scope="col" class="field-label col-date">Date</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      results.map((result) => (
        <tr role="row">
          <td role="cell" class="col-pos" data-label="Pos">
            <span class:list={['pos', { 'is-podium': result.position <= 3 }]}>
              P{result.position}
            </span>
            {/* Field size is what turns a position into evidence. It only
                prints when the record carries it. */}
            {result.entries && <span class="pos-field">of {result.entries}</span>}
          </td>
          <td role="cell" class="col-event" data-label="Event">
            <span class="event-name">{result.event}</span>
            <span class="event-series">{result.series}</span>
            <span class="event-sub">
              {result.track}.{result.note ? ` ${result.note}` : ''}
            </span>
          </td>
          <td role="cell" class="col-class" data-label="Class">
            <span class="chip">{result.class}</span>
          </td>
          <td role="cell" class="col-driver" data-label="Drivers">
            {result.drivers.join(' / ')}
          </td>
          <td role="cell" class="col-date" data-label="Date">
            {raceDate(result.date)}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .results {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .results th {
    padding-block: 0 0.7rem;
    border-bottom: 1px solid var(--line-strong);
    font-weight: 400;
  }

  .results td {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .results tbody tr:last-child td {
    border-bottom: none;
  }

  .col-pos {
    width: 6rem;
  }
  .col-class {
    width: 9.5rem;
  }
  .col-driver {
    width: 26%;
  }
  .col-date {
    width: 8.5rem;
  }

  .pos {
    display: block;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--ink-faint);
  }

  .pos.is-podium {
    color: var(--teal);
  }

  .pos-field {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-2xs);
    letter-spacing: var(--track-data);
    color: var(--ink-faint);
  }

  .event-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.25;
    /* `text-wrap: balance` is set on h1-h4 globally; this heading is a span
       inside a cell, so it needs saying here or it orphans a word. */
    text-wrap: balance;
  }

  .event-series {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* The track and the one-line story of the race: this is why the module
     exists, so it sits at the readable ink step, not the faintest one. */
  .event-sub {
    display: block;
    margin-top: 0.4rem;
    max-width: 56ch;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-dim);
    text-wrap: pretty;
  }

  .chip {
    display: inline-block;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--line);
  }

  .col-driver {
    font-size: var(--text-sm);
    color: var(--ink-dim);
    line-height: 1.5;
  }

  .col-date {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-2xs);
    letter-spacing: var(--track-data);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  /* No row hover: nothing in a row is clickable, and a background change
     promises a click that does not exist. */

  /* Under 860px the timing sheet becomes stacked entries. Explicit ARIA
     roles above keep the table semantics when display changes. */
  @media (max-width: 860px) {
    .results,
    .results tbody,
    .results tr,
    .results td {
      display: block;
      width: auto;
    }

    .results thead {
      display: none;
    }

    .results tr {
      position: relative;
      padding: var(--space-m) 0 var(--space-m) 4.75rem;
      border-bottom: 1px solid var(--line);
    }

    .results tbody tr:last-child {
      border-bottom: none;
    }

    .results td {
      padding-block: 0;
      border-bottom: none;
    }

    .col-pos {
      position: absolute;
      left: 0;
      top: var(--space-m);
    }

    .col-class,
    .col-driver,
    .col-date {
      margin-top: 0.6rem;
    }

    .col-driver::before,
    .col-date::before {
      content: attr(data-label) ': ';
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    .col-class {
      margin-top: 0.8rem;
    }
  }
</style>
