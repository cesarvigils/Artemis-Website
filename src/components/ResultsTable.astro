---
import { raceDate } from '../lib/format';
import type { RaceResult } from '../lib/data';

interface Props {
  results: RaceResult[];
  caption: string;
}

const { results, caption } = Astro.props;

/* The separator is glued to the name that follows it with a no-break space,
   so a wrapped driver list can never end a line on a bare "/" sitting beside
   the date column. */
const driverList = (names: string[]) =>
  names.map((name, i) => (i === 0 ? name : `/\u00A0${name}`)).join(' ');
---

<table class="results" role="table">
  <caption class="sr-only">{caption}</caption>
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col" class="field-label col-pos">Pos</th>
      <th role="columnheader" scope="col" class="field-label col-event">Event</th>
      <th role="columnheader" scope="col" class="field-label col-class">Class</th>
      <th role="columnheader" scope="col" class="field-label col-driver">Drivers</th>
      <th role="columnheader" scope="col" class="field-label col-date">Date</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      /* The timing tower fills row by row. This is the one entrance on the
         site that is *about* what it reveals, and it is a genuine sibling
         list rather than a wrapper - the distinction the reveal system has
         always drawn. The stagger is capped at six rows (225ms total) so a
         longer sheet never turns into a slideshow. */
      results.map((result, i) => (
        <tr role="row" class="reveal" style={`--reveal-delay: ${Math.min(i, 5) * 45}ms`}>
          <td role="cell" class="col-pos" data-label="Pos">
            {/* A podium is marked by a rule as well as by the teal, so it
                survives forced colours and reads for a colour-blind visitor. */}
            <span class:list={['pos', { 'is-podium': result.position <= 3 }]}>
              P{result.position}
              {result.position <= 3 && <span class="sr-only"> podium</span>}
            </span>
            {/* Field size is what turns a position into evidence. It only
                prints when the record carries it. */}
            {result.entries && <span class="pos-field">of {result.entries}</span>}
          </td>
          <td role="cell" class="col-event" data-label="Event">
            <span class="event-name">{result.event}</span>
            <span class="event-series">{result.series}</span>
            <span class="event-sub">
              {result.track}.{result.note ? ` ${result.note}` : ''}
            </span>
          </td>
          <td role="cell" class="col-class" data-label="Class">
            <span class="chip">{result.class}</span>
          </td>
          <td role="cell" class="col-driver" data-label="Drivers">
            {driverList(result.drivers)}
          </td>
          <td role="cell" class="col-date" data-label="Date">
            <span class="date-value">{raceDate(result.date)}</span>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .results {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .results th {
    padding-block: 0 0.7rem;
    border-bottom: 1px solid var(--line-strong);
    font-weight: var(--weight-small);
  }

  /* `baseline`, not `top`: the position marker is 28px and the event name is
     17px, so top-aligned they shared a box edge and their first baselines sat
     11px apart. In a layout that is meant to be a timing tower, column one
     has to line up with column two. */
  .results td {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }

  /* A real gutter, so column separation stops depending on how wide each
     class chip happens to be. Measured variance before this: 16px after
     "NASCAR Xfinity", 109px after "GT3", in the same column. */
  .results th,
  .results td {
    padding-inline-end: var(--space-l);
  }

  .results th:last-child,
  .results td:last-child {
    padding-inline-end: 0;
  }

  .results tbody tr:last-child td {
    border-bottom: none;
  }

  .col-pos {
    width: 6rem;
  }
  /* The chip sets its own column instead of a fixed 9.5rem that left a hole
     after short class names and none after long ones. */
  .col-class {
    width: 1%;
    white-space: nowrap;
  }
  .col-driver {
    width: 26%;
  }
  .col-date {
    width: 8.5rem;
  }

  .pos {
    display: inline-block;
    font-family: var(--font-data);
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--muted);
  }

  .pos.is-podium {
    color: var(--mist);
    border-bottom: 2px solid currentColor;
  }

  .pos-field {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-data);
    font-weight: var(--weight-small);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-2xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-data);
    color: var(--muted);
  }

  .event-name {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-base);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    line-height: var(--leading-snug);
    /* `text-wrap: balance` is set on h1-h4 globally; this heading is a span
       inside a cell, so it needs saying here or it orphans a word. */
    text-wrap: balance;
    /* A 57-character circuit name is one unbreakable token; without this it
       paints 408px outside its cell at 390 and the body clip eats it. */
    overflow-wrap: anywhere;
  }

  .event-series {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-data);
    font-weight: var(--weight-small);
    font-size: var(--text-2xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The track and the one-line story of the race: this is why the module
     exists, so it sits at the readable ink step, not the faintest one. */
  .event-sub {
    display: block;
    margin-top: 0.4rem;
    max-width: 56ch;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--mist-dim);
    text-wrap: pretty;
  }

  .chip {
    display: inline-block;
    white-space: nowrap;
    font-family: var(--font-data);
    font-weight: var(--weight-small);
    font-size: var(--text-2xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--line);
  }

  /* `td`, not the bare class. The column classes sit on the `<th>` as well,
     and a scoped `.col-driver` is (0,2,0) against `.field-label`'s (0,1,0) in
     global.css - so the Drivers header was rendering at 15px `--mist-dim` body
     type and the Date header at `--track-data` beside three 11px tracked mono
     labels. One row of column headers, one style. */
  td.col-driver {
    font-size: var(--text-sm);
    color: var(--mist-dim);
    line-height: var(--leading-body);
    overflow-wrap: anywhere;
  }

  td.col-date {
    font-family: var(--font-data);
    font-weight: var(--weight-small);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-2xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-data);
    color: var(--muted);
  }

  /* The date keeps itself on one line; the cell around it (which carries a
     "Date:" prefix in the stacked layout) is free to wrap. */
  .date-value {
    white-space: nowrap;
  }

  /* No row hover: nothing in a row is clickable, and a background change
     promises a click that does not exist. */

  /* Under 860px the timing sheet becomes stacked entries. Explicit ARIA
     roles above keep the table semantics when display changes. */
  @media (max-width: 860px) {
    .results,
    .results tbody,
    .results tr,
    .results td {
      display: block;
      width: auto;
    }

    /* Clipped, not deleted. `display: none` removes the node from the
       accessibility tree as well as from the screen, and an explicit
       `role="columnheader"` cannot survive that - measured at 390 and 768
       the whole header rowgroup collapsed to six ignored nodes and three of
       the five columns lost their name entirely. The row is absolutely
       positioned inside a `display: block` table, so it leaves the flow and
       costs no layout. */
    .results thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* The position gutter is capped as a share of the row as well as in rem:
       at a 200% root font 4.75rem is 152px of a 350px line. */
    .results tr {
      position: relative;
      padding: var(--space-m) 0 var(--space-m) min(4.75rem, 30%);
      border-bottom: 1px solid var(--line);
    }

    .results tbody tr:last-child {
      border-bottom: none;
    }

    .results td {
      padding-block: 0;
      padding-inline-end: 0;
      border-bottom: none;
    }

    .col-pos {
      position: absolute;
      left: 0;
      top: var(--space-m);
    }

    .col-class,
    .col-driver,
    .col-date {
      margin-top: 0.6rem;
    }

    /* `td`, not the bare class: the header row carries the same classes and
       no `data-label`, so an unscoped rule prefixed the clipped column
       headers with a bare ": " and a screen reader read ": DRIVERS". */
    td.col-driver::before,
    td.col-date::before {
      content: attr(data-label) ': ';
      font-family: var(--font-data);
      font-weight: var(--weight-small);
      font-size: var(--text-2xs);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--muted);
    }

    .col-class {
      margin-top: 0.8rem;
    }
  }

  /* A 768px tablet is not a phone: the stacked entry used about 60% of its
     line and made the section 54% taller than the same six rows at 1024. The
     row stays a stack but runs as three tracks, so the width is used. The
     explicit ARIA roles above keep this announced as a table throughout. */
  @media (min-width: 621px) and (max-width: 860px) {
    .results tr {
      display: grid;
      grid-template-columns: 4.75rem minmax(0, 1.7fr) minmax(0, 1fr);
      gap: var(--space-2xs) var(--space-m);
      align-content: start;
      padding-left: 0;
    }

    .col-pos {
      position: static;
      grid-area: 1 / 1 / span 3 / auto;
    }

    .col-event {
      grid-area: 1 / 2 / span 3 / auto;
    }

    .col-class {
      grid-area: 1 / 3 / auto / auto;
    }

    .col-driver {
      grid-area: 2 / 3 / auto / auto;
    }

    .col-date {
      grid-area: 3 / 3 / auto / auto;
    }

    .col-class,
    .col-driver,
    .col-date {
      margin-top: 0;
    }
  }
</style>
