---
import { raceDate, raceDateRange, raceTimeUtc } from '../lib/format';
import { eventTarget, type RaceEvent } from '../lib/data';

interface Props {
  /** Upcoming entries, soonest first. The first one is the next race. */
  upcoming: RaceEvent[];
  /** Shown as the subtitle when the calendar has run out. */
  lastDone?: RaceEvent;
}

const { upcoming, lastDone } = Astro.props;

const [next, ...alsoEntered] = upcoming;
const when = next ? raceDateRange(next.start, next.end) : '';
---

<section class="next-race rule-top" aria-labelledby="next-race-heading">
  <div class="container">
    <div class="next-race-inner">
      <h2 class="next-race-heading" id="next-race-heading">Next race</h2>

      {/* The empty branch is between seasons, not broken: the subtitle names
          the last thing that did happen, so the strip is still evidence
          rather than a gap. The wording is fixed - `docs/data-contract.md`
          quotes "No race scheduled" as the site's behaviour and the Discord
          bot is written against that document, so it changes on both sides
          or on neither. */}
      {
        next ? (
          <dl class="next-race-data">
            <div class="race-cell race-cell-event">
              <dt class="field-label">Event</dt>
              <dd>
                {next.name}
                <span class="race-status">{next.status}</span>
              </dd>
            </div>
            <div class="race-cell">
              <dt class="field-label">Track</dt>
              <dd>{next.track}</dd>
            </div>
            <div class:list={['race-cell', 'race-cell-when', { 'has-time': !!next.startTime }]}>
              <dt class="field-label">Date</dt>
              <dd>
                <span class="data">{when}</span>
                {/* The green flag, in UTC, as static text. The browser
                    rewrites it in the reader's own zone with the zone's
                    short name; without JS the UTC statement is still true,
                    and it occupies the same line either way. */}
                {next.startTime && (
                  <span class="race-time data" data-local-time={next.startTime}>
                    {raceTimeUtc(next.startTime)}
                  </span>
                )}
                <span
                  class="race-countdown data"
                  data-countdown={eventTarget(next)}
                  data-exact={next.startTime ? 'true' : undefined}
                  hidden
                />
              </dd>
            </div>
            <div class="race-cell">
              <dt class="field-label">Classes</dt>
              <dd class="data">{next.classes.join(' / ')}</dd>
            </div>
          </dl>
        ) : (
          <p class="race-empty">
            No race scheduled.
            {lastDone && (
              <span class="race-empty-sub data">
                Last out: {lastDone.name}, {raceDate(lastDone.start)}
              </span>
            )}
          </p>
        )
      }
    </div>

    {
      alsoEntered.length > 0 && (
        <ul class="also-entered">
          {alsoEntered.map((event) => (
            <li>
              <span class="also-date data">{raceDate(event.start)}</span>
              <span class="also-name">{event.name}</span>
              <span class="also-track">{event.track}</span>
              <span class="also-status data">{event.status}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .next-race {
    background: var(--surface-1);
    padding-block: var(--space-m);
  }

  .next-race-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
  }

  .next-race-heading {
    flex: 0 0 auto;
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-label);
    color: var(--mist);
  }

  .next-race-data {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
  }

  .race-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .race-cell dd {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-sm);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .race-cell .data {
    display: block;
    font-family: var(--font-data);
    font-weight: var(--weight-small);
    letter-spacing: var(--track-data);
    text-transform: none;
  }

  /* Reserve the countdown line so filling it in shifts nothing. A record
     with a start time reserves one line more, because the time is printed
     above the countdown. */
  .race-cell-when dd {
    min-height: 2.6em;
  }

  .race-cell-when.has-time dd {
    min-height: 3.9em;
  }

  .race-time {
    color: var(--muted);
  }

  .race-countdown {
    color: var(--mist);
  }

  .race-countdown[hidden] {
    display: none;
  }

  /* Whether an entry is locked in or still provisional is the one thing a
     calendar has to be honest about. */
  .race-cell dd .race-status {
    display: inline-block;
    margin-left: 0.55rem;
    font-family: var(--font-data);
    font-weight: var(--weight-small);
    font-size: var(--text-2xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .race-empty {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-sm);
    letter-spacing: var(--track-title);
    line-height: var(--leading-snug);
    text-transform: uppercase;
  }

  .race-empty-sub {
    display: block;
    margin-top: 0.3rem;
    font-weight: var(--weight-small);
    text-transform: none;
    letter-spacing: var(--track-data);
    color: var(--muted);
  }

  /* The rest of the calendar: the reason to come back, one hairline each. */
  .also-entered {
    margin-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .also-entered li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem var(--space-m);
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .also-entered li:last-child {
    border-bottom: none;
  }

  .also-date {
    flex: 0 0 7rem;
    font-size: var(--text-2xs);
    color: var(--muted);
  }

  .also-name {
    font-family: var(--font-display);
    font-weight: var(--weight-small);
    font-stretch: var(--wdth-normal);
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .also-track {
    font-size: var(--text-sm);
    color: var(--mist-dim);
    overflow-wrap: anywhere;
  }

  .also-status {
    margin-left: auto;
    font-size: var(--text-2xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .next-race-data {
      gap: var(--space-s) var(--space-m);
    }
    .race-cell-event {
      flex: 1 0 100%;
    }
    .also-date {
      flex: 0 0 auto;
    }
    .also-status {
      margin-left: 0;
    }
  }
</style>
