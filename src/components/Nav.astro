---
import { Image } from 'astro:assets';
import logo from '../assets/logos/Logo_Layout_1.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/team', label: 'Team' },
  { href: '/about', label: 'About' },
  { href: '/partners', label: 'Partners' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="Artemis Esports home">
      <Image src={logo} alt="Artemis Esports" height={44} densities={[1, 2]} />
    </a>

    <nav class="links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path === l.href.replace(/\/$/, '') || (l.href === '/' && path === '/') ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href="/partners#contact" class="btn btn-solid nav-cta">Get in touch</a>
    </nav>

    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/partners#contact" class="btn btn-solid">Get in touch</a>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition: transform 320ms var(--ease-out);
  }
  .site-nav.nav-hidden {
    transform: translateY(-100%);
  }
  .nav-inner {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: var(--pad-x);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand img {
    height: 44px;
    width: auto;
  }
  .links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }
  .links > a:not(.nav-cta) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color 200ms ease;
    padding-block: 0.5rem;
  }
  .links > a[aria-current='page'] {
    color: var(--teal);
  }
  @media (hover: hover) and (pointer: fine) {
    .links > a:not(.nav-cta):hover {
      color: var(--ink);
    }
  }
  .nav-cta {
    padding: 0.7rem 1.25rem;
    font-size: 0.8125rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    margin-inline: 10px;
    background: var(--ink);
    transition: transform 220ms var(--ease-out), opacity 220ms ease;
  }
  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 820px) {
    .links {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .mobile-menu {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1rem var(--pad-x) 2rem;
      border-top: 1px solid var(--line);
      background: var(--bg);
    }
    .mobile-menu[hidden] {
      display: none;
    }
    .mobile-menu > a:not(.btn) {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding-block: 0.9rem;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
    }
    .mobile-menu .btn {
      margin-top: 1.25rem;
      justify-content: center;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
