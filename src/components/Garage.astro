---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import GarageSlide from './GarageSlide.astro';
import cars from '../data/cars.json';

/* One static import per car photo, and each one is handed to <Image> as a
   bare identifier below. A dynamic reference (a glob, or `map[car.image]`)
   makes Vite copy every full-size original into dist next to the webp
   derivatives - that is what made the old build 72 MB. Captions stay in
   cars.json; changing a photo is a two-line edit here (see CONTENT.md). */
import sebringMustangGt3 from '../assets/racing/sebring-mustang-gt3.jpg';
import nordschleifeBmwM4 from '../assets/racing/nordschleife-bmw-m4.jpg';
import watkinsGlenGtp from '../assets/racing/watkins-glen-gtp.jpg';
import nascarXfinityChevy from '../assets/racing/nascar-xfinity-chevy.jpg';
import indianapolisIr18 from '../assets/racing/indianapolis-ir18.jpg';

/* One `sizes` string cannot describe three slide shapes. Above 900px the
   slide width is derived from `--frame-h` (24vw, capped at 22rem above
   1466px) and the shot's own ratio, so each shape gets the fraction it
   actually occupies plus the fixed width it settles at once the frame caps.
   The old single "46vw" had the browser fetching a 1024w file for a 275px
   portrait slide. */
const SIZES: Record<string, string> = {
  portrait: '(min-width: 1467px) 282px, (min-width: 901px) 20vw, 68vw',
  standard: '(min-width: 1467px) 626px, (min-width: 901px) 43vw, 84vw',
  wide: '(min-width: 1467px) 821px, (min-width: 901px) 56vw, 84vw',
};
const sizesFor = (i: number) => SIZES[cars[i].shape] ?? SIZES.standard;

/* `at ${track}` wants a circuit name. One record's track is the generic
   "Short track", and "at Short track" reads to a screen-reader user like an
   unfilled field, so a generic value takes a phrasing that is true of it. The
   data file is the bot's to write; this is the renderer's job. */
const altFor = (i: number) => {
  const { car, track } = cars[i];
  return /\btrack\b|\boval\b/i.test(track)
    ? `${car} in the Artemis livery on a ${track.toLowerCase()}`
    : `${car} in the Artemis livery at ${track}`;
};
---

<section class="garage rule-top" id="garage" aria-labelledby="garage-heading">
  <div class="container">
    <div class="section-head">
      <h2 class="display-md" id="garage-heading">The garage</h2>
      <div class="garage-controls" data-garage-controls>
        <button type="button" class="garage-btn" data-garage-prev aria-controls="garage-track">
          <span class="sr-only">Previous car</span>
          <Icon name="arrow-left" size={18} />
        </button>
        <button type="button" class="garage-btn" data-garage-next aria-controls="garage-track">
          <span class="sr-only">Next car</span>
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>
  </div>

  {/* The scrollable region is the wrapper, not the list: `role="region"` on a
      <ul> overrides its implicit list role and orphans every <li> in it. A
      labelled <section> *is* `role="region"`, so the element says it rather
      than asserting it with an attribute. */}
  <section
    class="garage-viewport"
    id="garage-track"
    data-garage-track
    tabindex="0"
    aria-label="Artemis liveries, scroll sideways"
  >
    <ul class="garage-track">
      <GarageSlide car={cars[0].car} track={cars[0].track} caption={cars[0].caption} shape={cars[0].shape}>
        {/* Ladders stop at each source's own width so Astro never upscales.
            The two portrait slides carry a 560 rung: on the mobile profile the
            frame needs 487px and the ladder jumped 480 -> 640, which pulled
            35 KB for a 20 KB job. */}
        <Image src={sebringMustangGt3} alt={altFor(0)} widths={[320, 480, 560, 640, 1024]} sizes={sizesFor(0)} format="webp" quality={72} loading="lazy" decoding="async" />
      </GarageSlide>

      <GarageSlide car={cars[1].car} track={cars[1].track} caption={cars[1].caption} shape={cars[1].shape}>
        <Image src={nordschleifeBmwM4} alt={altFor(1)} widths={[320, 480, 640, 960, 1089]} sizes={sizesFor(1)} format="webp" quality={72} loading="lazy" decoding="async" />
      </GarageSlide>

      <GarageSlide car={cars[2].car} track={cars[2].track} caption={cars[2].caption} shape={cars[2].shape}>
        <Image src={watkinsGlenGtp} alt={altFor(2)} widths={[320, 480, 560, 640, 1024]} sizes={sizesFor(2)} format="webp" quality={72} loading="lazy" decoding="async" />
      </GarageSlide>

      <GarageSlide car={cars[3].car} track={cars[3].track} caption={cars[3].caption} shape={cars[3].shape}>
        <Image src={nascarXfinityChevy} alt={altFor(3)} widths={[320, 480, 640, 960, 1280]} sizes={sizesFor(3)} format="webp" quality={72} loading="lazy" decoding="async" />
      </GarageSlide>

      <GarageSlide car={cars[4].car} track={cars[4].track} caption={cars[4].caption} shape={cars[4].shape}>
        <Image src={indianapolisIr18} alt={altFor(4)} widths={[320, 480, 640, 960, 1280]} sizes={sizesFor(4)} format="webp" quality={72} loading="lazy" decoding="async" />
      </GarageSlide>
    </ul>
  </section>

  <div class="container">
    <div class="garage-progress" aria-hidden="true">
      <span data-garage-progress></span>
    </div>
  </div>
</section>

<style>
  .garage {
    padding-block: var(--space-2xl);
    overflow: clip;
  }

  /* The row keeps its height whether or not the arrows are usable, so
     revealing them never nudges the heading beside them. */
  .garage-controls {
    display: flex;
    gap: 0.5rem;
    min-height: 44px;
    visibility: hidden;
  }

  .garage-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out-quart),
      color var(--dur-2) var(--ease-out-quart),
      transform var(--dur-1) var(--ease-out-quart);
  }

  /* The glyph dims, the box does not. At 0.3 on the whole control the arrow
     composited to 2.5:1 and read as *gone* rather than as unavailable, which
     defeats the `visibility` handling above that deliberately keeps the row's
     height. Disabled controls are exempt from 1.4.11; this is craft, not
     compliance. */
  .garage-btn:disabled {
    cursor: default;
  }

  .garage-btn:disabled :global(svg) {
    opacity: 0.45;
  }

  .garage-btn :global(svg) {
    transition: opacity var(--dur-2) var(--ease-out-quart);
  }

  /* One press scale for every control on the site: 0.94 was a second answer
     to a question the buttons had already answered. */
  .garage-btn:active:not(:disabled) {
    transform: scale(var(--press-scale));
  }

  @media (hover: hover) and (pointer: fine) {
    .garage-btn:hover:not(:disabled) {
      border-color: var(--teal);
      color: var(--teal);
    }
  }

  .garage-btn:focus-visible:not(:disabled) {
    border-color: var(--teal);
    color: var(--teal);
  }

  /* Native horizontal scroll on every device. No pinning, no hijack. */
  .garage-viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* Line the first slide up with the container gutter, not the viewport. */
    scroll-padding-inline: max(var(--pad-x), calc((100% - var(--shell)) / 2 + var(--pad-x)));
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .garage-viewport::-webkit-scrollbar {
    display: none;
  }

  .garage-track {
    display: flex;
    gap: var(--space-m);
    padding-inline: max(var(--pad-x), calc((100% - var(--shell)) / 2 + var(--pad-x)));
    padding-bottom: var(--space-m);
    width: max-content;
  }

  .garage-progress {
    height: 2px;
    background: var(--line);
    margin-top: var(--space-s);
    overflow: hidden;
  }

  /* Sized by script to the share of the strip on screen, so it reports how
     much is left rather than sitting at a 1px stub. */
  .garage-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--teal);
  }

  @media (prefers-reduced-motion: reduce) {
    .garage-btn:active:not(:disabled) {
      transform: none;
    }
  }
</style>
