---
/**
 * The only icon set on the site. Inline SVG, one stroke weight (1.5),
 * square caps and mitred joins to match the square shape system.
 * Icons are affordances only - brand/social links are typographic.
 */
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'menu' | 'close';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const PATHS: Record<Props['name'], string> = {
  'arrow-right': 'M3 12h18M14 5l7 7-7 7',
  'arrow-left': 'M21 12H3M10 5l-7 7 7 7',
  'arrow-up-right': 'M6 18 18 6M8 6h10v10',
  menu: 'M3 7h18M3 17h18',
  close: 'M5 5l14 14M19 5 5 19',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[name]}></path>
</svg>
