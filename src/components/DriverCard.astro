---
import Icon from './Icon.astro';
import { raceDate } from '../lib/format';
import { socialLabel } from '../lib/links';
import type { Driver, RaceResult } from '../lib/data';

interface Props {
  driver: Driver;
  /** "compact" is the home-page teaser column, "row" the full roster entry. */
  variant?: 'compact' | 'row';
  href?: string;
  /** Their most recent race, matched on name in results.json. */
  lastResult?: RaceResult;
  class?: string;
  style?: string;
}

const {
  driver,
  variant = 'compact',
  href,
  lastResult,
  class: className,
  style,
} = Astro.props;

const socials = Object.entries(driver.socials ?? {}).filter(([, url]) => url);
/* `null` used to pass this filter, so `"stats": {"irating": null}` from the
   bot rendered a <dt>iRating</dt> above an empty <dd>. iRating is typed as an
   integer, so 0 is not a rating either - it is a missing value that would read
   on the page as a real one. */
const stats = [
  { label: 'iRating', value: Number.isFinite(driver.stats?.irating) && (driver.stats?.irating ?? 0) > 0 ? driver.stats?.irating : undefined },
  { label: 'Licence', value: driver.stats?.licence },
].filter((stat) => stat.value !== undefined && stat.value !== null && stat.value !== '');
---

{
  variant === 'compact' ? (
    <li class:list={['driver-compact', className]} style={style}>
      <a href={href ?? `/team#${driver.id}`}>
        {
          driver.number && (
            <span class="driver-number" aria-hidden="true">
              {driver.number}
            </span>
          )
        }
        <span class="driver-name">{driver.name}</span>
        <span class="driver-focus">{driver.focus}</span>
        <span class="driver-country data">{driver.country}</span>
      </a>
    </li>
  ) : (
    <li
      id={driver.id}
      class:list={['driver-row', className, { 'has-number': !!driver.number }]}
      style={style}
    >
      {
        driver.number && (
          <span class="driver-number" aria-hidden="true">
            {driver.number}
          </span>
        )
      }
      <div class="driver-identity">
        <h3 class="driver-name">{driver.name}</h3>
        <p class="driver-meta data">
          {driver.country}
          {driver.number ? ` / No. ${driver.number}` : ''}
        </p>
      </div>
      <div class="driver-detail">
        <p class="driver-focus">{driver.focus}</p>
        {driver.bio && <p class="driver-bio">{driver.bio}</p>}
        {/* Evidence per person, derived from results.json rather than typed
            twice: the one thing a prospective driver wants to see. */}
        {lastResult && (
          <p class="driver-last data">
            Last drive: P{lastResult.position}
            {lastResult.entries ? ` of ${lastResult.entries}` : ''}, {lastResult.event},{' '}
            {/* One date, one line: at 1024 this string used to split
                "06 / SEP 2026" across two of them. */}
            <span class="nowrap">{raceDate(lastResult.date)}</span>
          </p>
        )}
        {stats.length > 0 && (
          <dl class="driver-stats">
            {stats.map((stat) => (
              <div>
                <dt class="field-label">{stat.label}</dt>
                <dd class="data">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {/* Same two things every other text link that leaves the site
            carries: the channel's own spelling, and the up-right glyph. A
            logo link does not take the glyph (the mark is the label); a word
            does. */}
        {socials.length > 0 && (
          <ul class="driver-socials">
            {socials.map(([name, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener">
                  <span>{socialLabel(name)}</span>
                  <Icon name="arrow-up-right" size={13} />
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </li>
  )
}

<style>
  /* Compact: a column in the home teaser, separated by hairlines only.
     No card box, no shadow. */
  /* The inset comes from the page through `--compact-inset`: the <ul> owns
     the column hairlines but its selectors cannot out-specify this scoped
     shorthand, so the page sets a property instead of fighting the cascade. */
  .driver-compact > a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: var(--space-m) var(--space-s) var(--space-m) var(--compact-inset, 0px);
    transition: color var(--dur-2) var(--ease-out-quart),
      opacity var(--dur-1) var(--ease-out-quart);
  }

  .driver-compact .driver-number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    /* Same cascade trap as `--compact-inset`: the page's
       `.roster-teaser > li:first-child .driver-number` is (0,3,0) against this
       scoped rule's (0,4,0), so the lead cell's larger number never applied
       and all four columns rendered identically. */
    font-size: var(--compact-number-size, var(--number-md));
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--teal-soft);
    margin-bottom: var(--space-2xs);
    /* All three properties one hover moves are on one clock. They used to run
       on three: the fill eased over 240ms, the stroke colour snapped because
       it was missing from the list, and the name snapped because it had no
       list at all. */
    transition: color var(--dur-2) var(--ease-out-quart),
      -webkit-text-stroke-color var(--dur-2) var(--ease-out-quart);
  }

  .driver-compact .driver-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    text-wrap: balance;
    overflow-wrap: anywhere;
    transition: color var(--dur-2) var(--ease-out-quart);
  }

  .driver-compact .driver-focus {
    font-size: var(--text-sm);
    color: var(--ink-dim);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .driver-compact .driver-country {
    margin-top: auto;
    padding-top: var(--space-s);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--text-2xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .driver-compact > a:hover .driver-number {
      color: var(--teal);
      -webkit-text-stroke-color: var(--teal);
    }
    .driver-compact > a:hover .driver-name {
      color: var(--teal);
    }
  }

  .driver-compact > a:focus-visible .driver-number {
    color: var(--teal);
    -webkit-text-stroke-color: var(--teal);
  }

  .driver-compact > a:focus-visible .driver-name {
    color: var(--teal);
  }

  /* Row: the full roster entry, laid out like a timing sheet line. */
  .driver-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.6fr);
    gap: var(--space-m);
    align-items: start;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  .driver-row:last-child {
    border-bottom: none;
  }

  /* Crew have no car number; their name starts in the name column. */
  .driver-row:not(.has-number) .driver-identity {
    grid-column: 2;
  }

  .driver-row .driver-number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: var(--number-md);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--teal-soft);
  }

  .driver-row .driver-name {
    font-size: var(--text-xl);
    letter-spacing: var(--track-title);
    text-wrap: balance;
  }

  /* `-webkit-text-stroke` is non-standard. Without it the number would be a
     transparent glyph in an empty slot, so the fallback is a solid fill. */
  @supports not (-webkit-text-stroke: 1px currentColor) {
    .driver-number {
      color: var(--teal-soft);
    }
  }

  .driver-last {
    margin-top: var(--space-s);
    color: var(--ink-dim);
    font-size: var(--text-2xs);
    letter-spacing: var(--track-data);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  .nowrap {
    white-space: nowrap;
  }

  .driver-meta {
    margin-top: 0.35rem;
    color: var(--ink-faint);
    font-size: var(--text-2xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .driver-row .driver-focus {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--teal);
    /* "Trucks / Superspeedway" is 243px of tracked caps at a 200% root. */
    overflow-wrap: anywhere;
  }

  .driver-bio {
    margin-top: 0.5rem;
    color: var(--ink-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .driver-stats {
    display: flex;
    gap: var(--space-m);
    margin-top: var(--space-s);
  }

  .driver-stats dd {
    margin-top: 0.2rem;
    color: var(--ink);
    font-size: var(--text-sm);
  }

  .driver-socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }

  /* 44px of target, with the hairline still sitting on the word: the height
     lives on the anchor, the underline on the span inside it. */
  .driver-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: var(--track-link);
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color var(--dur-2) var(--ease-out-quart),
      opacity var(--dur-1) var(--ease-out-quart);
  }

  .driver-socials a > span:first-child {
    border-bottom: 1px solid var(--line);
    transition: border-color var(--dur-2) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .driver-socials a:hover {
      color: var(--teal);
    }
    .driver-socials a:hover > span:first-child {
      border-color: var(--teal);
    }
  }

  .driver-socials a:focus-visible {
    color: var(--teal);
  }

  .driver-socials a:focus-visible > span:first-child {
    border-color: var(--teal);
  }

  /* The whole 761-1200px band - most tablets and small laptops - gave the
     name column 197px against a 25.8px name, so every road driver's name
     broke across two lines. One band rule, not a new breakpoint. */
  @media (min-width: 761px) and (max-width: 1200px) {
    .driver-row {
      grid-template-columns: 4rem minmax(0, 1.35fr) minmax(0, 1.5fr);
    }

    .driver-row .driver-name {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 760px) {
    .driver-row {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: var(--space-s) var(--space-m);
    }
    /* No size override here any more: `--number-md` is a fluid token, so the
       number already steps down with the heading scale. */
    .driver-detail {
      grid-column: 2 / -1;
    }
  }
</style>
